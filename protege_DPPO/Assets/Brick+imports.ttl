            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Thermal ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Collector,
        tag:Equipment,
        tag:Solar,
        tag:Thermal .

brick:Speed_Mode_Status a owl:Class,
        sh:NodeShape ;
    rdfs:label "Speed Mode Status"@en ;
    rdfs:subClassOf brick:Mode_Status ;

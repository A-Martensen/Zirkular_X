    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .

unit:POISE-PER-PA a qudt:Unit ;
    rdfs:label "poise per pascal"^^xsd:string ;
    dcterms:description "[CGS] unit poise divided by the SI derived unit pascal"^^xsd:string ;

            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Command,
        tag:Maintenance,
        tag:Mode,
        tag:Point .

brick:Maintenance_Required_Alarm a owl:Class,

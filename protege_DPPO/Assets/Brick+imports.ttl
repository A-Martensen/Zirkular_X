        unit:KiloJ,
        unit:KiloVA-HR,
        unit:KiloVAR-HR,
        unit:KiloW-HR,
        unit:MegaBTU_IT,
        unit:MegaEV,
        unit:MegaJ,
        unit:MegaTOE,
        unit:MegaVA-HR,
        unit:MegaVAR-HR,

        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:door-extended-pulse-time ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 0 ;

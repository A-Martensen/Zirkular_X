    qudt:scalingOf unit:M3 ;
    qudt:symbol "bsh{UK}"^^xsd:string ;
    qudt:ucumCode "[bu_br]"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "BUI"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .


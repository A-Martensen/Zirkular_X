            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Supply ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Cool,
        tag:Discharge,
        tag:Flow,
        tag:Limit,
        tag:Max,
        tag:Parameter,
        tag:Point,
        tag:Setpoint,
        tag:Supply .


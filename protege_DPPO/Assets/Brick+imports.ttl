            sh:path bacnet:monitored-property-identifier ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:maxInclusive 4294967295 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;

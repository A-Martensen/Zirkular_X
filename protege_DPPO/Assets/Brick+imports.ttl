    qudt:plainTextDescription "product of the SI derived unit hertz and the SI base unit metre"^^xsd:string ;
    qudt:symbol "Hz·m"^^xsd:string ;
    qudt:ucumCode "Hz.m"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "H34"^^xsd:string ;

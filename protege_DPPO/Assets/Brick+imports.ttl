            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Occupancy,
        tag:Point,
        tag:Sensor ;
    brick:hasQuantity brick:Occupancy .


    qudt:hasQuantityKind qudtqk:NumberDensity ;
    qudt:symbol "#/m³"^^xsd:string ;
    qudt:ucumCode "/m3"^^qudt:UCUMcs,
        "{#}.m-3"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .

unit:NUM-PER-MilliM3 a qudt:Unit ;

    qudt:hasQuantityKind qudtqk:MassPerAreaTime ;
    qudt:symbol "g/(cm²·a)"^^xsd:string ;
    qudt:ucumCode "g.cm-2.a-1"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .


    qudt:hasFactorUnit [ qudt:exponent 1 ;
            qudt:hasUnit unit:J ],
        [ qudt:exponent -2 ;
            qudt:hasUnit unit:M ] ;
    qudt:hasQuantityKind qudtqk:EnergyFluence,

        [ a sh:TripleRule ;
            sh:object tag:Switch ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Equipment,
        tag:Interface,
        tag:Switch .


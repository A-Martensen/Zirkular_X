brick:Lowest_Exhaust_Air_Static_Pressure_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Lowest Exhaust Air Static Pressure Sensor"@en ;
    rdfs:subClassOf brick:Exhaust_Air_Static_Pressure_Sensor ;

            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Coldest,
        tag:Point,
        tag:Sensor,
        tag:Temperature,
        tag:Zone ;
    brick:hasQuantity qudtqk:Temperature .

brick:Collection_Basin_Water_Heater a owl:Class,

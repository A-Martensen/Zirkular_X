            qudt:hasUnit unit:BAR ],
        [ qudt:exponent 3 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:SEC ] ;
    qudt:hasQuantityKind qudtqk:Power ;
    qudt:iec61360Code "0112/2///62720#UAA814"^^xsd:string ;

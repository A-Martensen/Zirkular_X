    qudt:hasQuantityKind qudtqk:LinearVelocity,
        qudtqk:Velocity ;
    qudt:iec61360Code "0112/2///62720#UAA638"^^xsd:string ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Kilometres_per_hour?oldid=487674812"^^xsd:anyURI,

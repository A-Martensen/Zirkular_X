            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Natural ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Boiler,
        tag:Equipment,
        tag:Gas,
        tag:Natural .


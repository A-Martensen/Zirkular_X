            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Room ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Point,
        tag:Room,
        tag:Setpoint,
        tag:Temperature ;
    brick:hasQuantity qudtqk:Temperature ;
    brick:hasSubstance brick:Air .

brick:Safety_System a owl:Class,
        sh:NodeShape ;

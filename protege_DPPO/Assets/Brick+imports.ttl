    qudt:plainTextDescription "Volumen dividiert durch Temperatur"@de ;
    qudt:symbol "0173-1#Z4-BAJ398#002"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/quantitykind> .


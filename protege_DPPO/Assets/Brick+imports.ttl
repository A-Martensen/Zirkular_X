            sh:object tag:Thermal ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Chilled,
        tag:Energy,
        tag:Equipment,
        tag:Storage,
        tag:Tank,
        tag:Thermal,
        tag:Water .


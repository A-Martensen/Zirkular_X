unit:NanoGM a qudt:Unit ;
    rdfs:label "Nanogram"@en ;
    dcterms:description "10**-9 grams or one 10**-12 of the SI standard unit of mass (kilogram)."@en ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>,

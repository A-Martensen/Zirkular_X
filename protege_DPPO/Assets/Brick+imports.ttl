    rdfs:subClassOf bacnet:Choice ;
    sh:xone ( [ sh:property [ a sh:PropertyShape ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path bacnet:property-value ] ] [ sh:property [ a sh:PropertyShape ;
                        sh:class bacnet:Error ;
                        sh:maxCount 1 ;

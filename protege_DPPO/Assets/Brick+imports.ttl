bacnet:SpecialEvent a sh:NodeShape ;
    rdfs:label "SpecialEvent"^^xsd:string ;
    rdfs:subClassOf bacnet:Sequence ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:list-of-time-values ],
        [ a sh:PropertyShape ;
            sh:class bacnet:SpecialEvent.Period ;

            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:status ] .

bacnet:Scale a sh:NodeShape ;
    rdfs:label "Scale"^^xsd:string ;
    rdfs:subClassOf bacnet:Choice ;
    sh:xone ( [ sh:property [ a sh:PropertyShape ;
                        sh:datatype xsd:float ;

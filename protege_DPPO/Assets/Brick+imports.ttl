    owl:equivalentClass brick:Max_Cooling_Discharge_Air_Flow_Setpoint_Limit ;
    skos:definition "A parameter that places an upper bound on the range of permitted values of a Cooling_Supply_Air_Flow_Setpoint."@en ;

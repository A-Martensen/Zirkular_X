    qudt:symbol "mm/h"^^xsd:string ;
    qudt:ucumCode "mm.h-1"^^qudt:UCUMcs,
        "mm/h"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "H67"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .


            sh:object tag:Ice ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Leaving ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

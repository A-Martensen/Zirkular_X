        unit:PER-MO,
        unit:PER-MilliSEC,
        unit:PER-SEC,
        unit:PER-WK,
        unit:PER-YR,
        unit:PERCENT-PER-DAY,
        unit:PERCENT-PER-HR,
        unit:PERCENT-PER-MO,
        unit:PERCENT-PER-WK,
        unit:PERCENT-PER-YR,
        unit:PPTH-PER-HR,
        unit:PetaHZ,
        unit:PlanckFrequency,
        unit:SAMPLE-PER-SEC,
        unit:TeraHZ ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0> ;
    qudt:iec61360Code "0112/2///62720#UAD064"^^xsd:string ;

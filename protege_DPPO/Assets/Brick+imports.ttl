            sh:class bacnet:PropertyIdentifierEnumerationValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:property-identifier ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;

        qudtqk:MassDensity ;
    qudt:iec61360Code "0112/2///62720#UAA997"^^xsd:string ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA997"^^xsd:anyURI ;

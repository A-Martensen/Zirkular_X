    rdfs:label "Imperial Ounce Force Inch"@en ;
    dcterms:description "\"Ounce Force Inch\" is an Imperial unit for  'Torque' expressed as $ozf-in$."^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,

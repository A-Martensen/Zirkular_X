bacnet:ConfirmedCOVNotificationMultipleRequest.ListOfCovNotificationsSequence a sh:NodeShape ;
    rdfs:label "ConfirmedCOVNotificationMultipleRequest.ListOfCovNotificationsSequence"^^xsd:string ;

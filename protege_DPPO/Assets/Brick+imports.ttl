        [ a sh:PropertyShape ;
            sh:in ( unit:MIL unit:MilliRAD unit:RAD unit:REV unit:GRAD unit:DEG unit:GON unit:ARCSEC unit:ARCMIN unit:MilliARCSEC unit:MicroRAD ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;

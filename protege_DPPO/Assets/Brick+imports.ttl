    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloGM ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:MicroBQ ] ;
    qudt:hasQuantityKind qudtqk:SpecificActivity ;

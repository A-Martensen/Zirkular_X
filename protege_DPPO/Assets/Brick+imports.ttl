    qudt:ucumCode "mV.m-1"^^qudt:UCUMcs,
        "mV/m"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "C30"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> .


    qudt:hasQuantityKind qudtqk:MassPerAreaTime ;
    qudt:plainTextDescription "0.0001-fold of the SI base unit kilogram divided by the SI base unit meter with the exponent 2 over a period of 1 hour "^^xsd:string ;

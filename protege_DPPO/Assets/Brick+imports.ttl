    rdfs:comment "Applicable units are those of quantitykind:LinearMass"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/quantitykind> .

qudtqk:LinearTorque a qudt:QuantityKind ;

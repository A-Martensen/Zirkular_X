        [ a sh:PropertyShape ;
            bacnet:comment "see Clause 20.2.12 for restrictions"@en ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:date ;
            sh:pattern "^([0-9]{4})-([0-9]{2})-([0-9]{2}|[*])( ([0-9]|[*]))?$"^^xsd:string ] .


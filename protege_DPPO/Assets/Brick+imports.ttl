unit:NanoMOL-PER-GM a qudt:Unit ;
    rdfs:label "Nanomoles per gram"@en ;
    dcterms:description "Nanomole Per Gram (\\(nanomol/g\\)) is a unit of Molality"^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/SI> ;

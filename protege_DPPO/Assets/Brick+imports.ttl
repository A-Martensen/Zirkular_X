        unit:HP_Electric,
        unit:HP_Metric,
        unit:HectoPA-L-PER-SEC,
        unit:HectoPA-M3-PER-SEC,
        unit:J-PER-DAY,
        unit:J-PER-HR,
        unit:J-PER-MIN,
        unit:J-PER-SEC,
        unit:KiloBTU_IT-PER-HR,
        unit:KiloCAL-PER-MIN,
        unit:KiloCAL-PER-SEC,
        unit:KiloGM_F-M-PER-SEC,
        unit:KiloJ-PER-DAY,
        unit:KiloJ-PER-HR,
        unit:KiloJ-PER-MIN,
        unit:KiloJ-PER-SEC,
        unit:KiloW,
        unit:MegaBTU_IT-PER-HR,
        unit:MegaJ-PER-HR,
        unit:MegaJ-PER-SEC,
        unit:MegaPA-L-PER-SEC,

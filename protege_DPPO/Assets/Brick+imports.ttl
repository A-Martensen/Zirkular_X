            sh:object tag:RVAV ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Reheat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

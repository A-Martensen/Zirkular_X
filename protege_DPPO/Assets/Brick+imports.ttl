            sh:maxCount 1 ;
            sh:maxInclusive 18446744073709551615 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path bacnet:sequence-number ],
        [ a sh:PropertyShape ;
            sh:class bacnet:AuditLogRecord ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:assigned-access-rights ] .


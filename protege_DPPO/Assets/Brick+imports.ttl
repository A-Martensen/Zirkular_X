                        sh:class bacnet:VTOpenRequest ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path bacnet:vt-open ] ] [ sh:property [ a sh:PropertyShape ;
                        sh:class bacnet:VTCloseRequest ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;

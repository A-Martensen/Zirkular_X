            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Unit ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Condenser,
        tag:Condensing,
        tag:Cooling,
        tag:Equipment,
        tag:Heating,
        tag:Unit .


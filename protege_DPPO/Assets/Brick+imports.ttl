            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Gauge,
        tag:Hot,
        tag:Point,
        tag:Pressure,
        tag:Sensor,
        tag:Water ;
    brick:hasQuantity qudtqk:GaugePressure .


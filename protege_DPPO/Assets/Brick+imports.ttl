            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Speed ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Status ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Mode,
        tag:Point,
        tag:Speed,
        tag:Status .

brick:Speed_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Speed Setpoint"@en ;
    rdfs:subClassOf brick:Setpoint ;
    skos:definition "Sets speed"@en ;

    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:SEC ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:MilliM ] ;
    qudt:hasQuantityKind qudtqk:LinearVelocity,
        qudtqk:Velocity ;
    qudt:iec61360Code "0112/2///62720#UAA867"^^xsd:string ;

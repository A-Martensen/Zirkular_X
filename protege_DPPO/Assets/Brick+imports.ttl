    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:enabled ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path bacnet:port-id ] .


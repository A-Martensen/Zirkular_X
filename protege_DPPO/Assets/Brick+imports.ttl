    sh:rule [ a sh:TripleRule ;
            sh:object tag:Entering ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:High ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

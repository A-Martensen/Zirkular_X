    qudt:hasQuantityKind qudtqk:Mass ;
    qudt:iec61360Code "0112/2///62720#UAB076"^^xsd:string ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB076"^^xsd:anyURI ;

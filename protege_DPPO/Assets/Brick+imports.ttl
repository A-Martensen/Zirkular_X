    qudt:expression "oz/in^{3}"^^xsd:string ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0> ;
    qudt:hasFactorUnit [ qudt:exponent 1 ;

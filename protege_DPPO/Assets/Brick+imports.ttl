    qudt:hasQuantityKind qudtqk:SerumOrPlasmaLevel ;
    qudt:symbol "IU/L"^^xsd:string ;
    qudt:ucumCode "[IU].L-1"^^qudt:UCUMcs,
        "[IU]/L"^^qudt:UCUMcs,
        "[iU].L-1"^^qudt:UCUMcs,
        "[iU]/L"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> ;
    rdfs:seeAlso unit:IU .


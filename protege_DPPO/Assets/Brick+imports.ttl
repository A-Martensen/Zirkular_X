            sh:maxCount 1 ;
            sh:maxInclusive 65535 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path bacnet:remaining-time-to-live ] .

bacnet:FaultParameter a sh:NodeShape ;
    rdfs:label "FaultParameter"^^xsd:string ;

    sh:rule [ a sh:TripleRule ;
            sh:object tag:Floor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Level ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

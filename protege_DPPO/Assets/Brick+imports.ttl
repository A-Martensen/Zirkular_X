rec:IAQSensorEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Indoor Air Quality Sensor"^^xsd:string ;
    rdfs:comment "Indoor air quality sensor."^^xsd:string ;
    rdfs:subClassOf rec:SensorEquipment ;

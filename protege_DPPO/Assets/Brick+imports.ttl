qudtqk:MigrationLength a qudt:QuantityKind ;
    rdfs:label "Migration Length"@en ;
    dcterms:description "\"Migration Length\" is the square root of the migration area."^^qudt:LatexString ;
    qudt:applicableUnit unit:ANGSTROM,

    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:L ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:FemtoGM ] ;
    qudt:hasQuantityKind qudtqk:Density,

    rdfs:label "Hectopascal per Bar"@en ;
    dcterms:description "100-fold of the SI derived unit pascal divided by the unit bar"^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS> ;

    sh:xone ( [ sh:property [ a sh:PropertyShape ;
                        sh:class bacnet:AuditLogQueryParameters.ByTarget ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path bacnet:by-target ] ] [ sh:property [ a sh:PropertyShape ;

    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0> ;
    qudt:hasFactorUnit [ qudt:exponent 1 ;
            qudt:hasUnit unit:TON_Metric ],
        [ qudt:exponent -1 ;

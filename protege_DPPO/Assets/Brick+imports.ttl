    qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/USCS> ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0> ;
    qudt:hasQuantityKind qudtqk:Mass ;

    qudt:conversionMultiplierSN 3.6e+06 ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0> ;
    qudt:hasFactorUnit [ qudt:exponent 1 ;

    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0> ;
    qudt:hasQuantityKind qudtqk:Time ;
    qudt:prefix <http://qudt.org/vocab/prefix/Kilo> ;
    qudt:scalingOf unit:YR ;

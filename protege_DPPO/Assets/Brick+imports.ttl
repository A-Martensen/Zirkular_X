brick:Class a owl:Class,
        sh:NodeShape ;
    rdfs:label "Class"@en ;
    rdfs:subClassOf brick:Entity .

brick:Condenser_Water_Temperature_Sensor a owl:Class,
        sh:NodeShape ;

            sh:pattern "^[A-Za-z0-9-]+,[1-9][0-9]*$"^^xsd:string ] .

bacnet:RouterEntry a sh:NodeShape ;
    rdfs:label "RouterEntry"^^xsd:string ;
    rdfs:subClassOf bacnet:Sequence ;
    sh:property [ a sh:PropertyShape ;

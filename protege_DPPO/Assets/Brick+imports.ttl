    rdfs:subClassOf bacnet:Sequence ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue 1 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:pdu-type ],
        [ a sh:PropertyShape ;
            sh:class bacnet:UnconfirmedServiceRequest ;
            sh:maxCount 1 ;

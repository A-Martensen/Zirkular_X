@prefix zx:   <https://zirkular-x.tech/ontology/zx#> .
@prefix ex:   <https://example.org/zx/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/zx/abox> a owl:Ontology ;
    owl:imports <https://zirkular-x.tech/ontology/zx> .

##  Vokabular  #########################################################

ex:GWPtotal   a zx:EnvironmentalIndicator ; rdfs:label "GWP total"@en .
ex:ODP        a zx:EnvironmentalIndicator ; rdfs:label "Ozone depletion potential"@en , "Ozonabbaupotenzial"@de .
ex:RatedPower a zx:TechnicalIndicator     ; rdfs:label "Rated power"@en , "Nennleistung"@de .
ex:NetWeight  a zx:PhysicalIndicator      ; rdfs:label "Net weight"@en , "Nettogewicht"@de .

ex:kgCO2eq   a zx:Unit ; rdfs:label "kg CO2-eq"@en .
ex:kgCFC11eq a zx:Unit ; rdfs:label "kg CFC-11-eq"@en .
ex:kW        a zx:Unit ; rdfs:label "kW"@en .
ex:kg        a zx:Unit ; rdfs:label "kg"@en .
ex:percent   a zx:Unit ; rdfs:label "%"@en .

ex:A1-A3 a zx:LifeCycleModule ; rdfs:label "A1-A3"@en .
ex:C3    a zx:LifeCycleModule ; rdfs:label "C3"@en .
ex:D     a zx:LifeCycleModule ; rdfs:label "D"@en .

ex:OnePiece a zx:DeclaredUnit ; rdfs:label "1 piece"@en , "1 Stueck"@de .

ex:Steel  a zx:Material ; rdfs:label "Steel"@en , "Stahl"@de .
ex:Copper a zx:Material ; rdfs:label "Copper"@en , "Kupfer"@de .
ex:R290   a zx:HazardousSubstance   ; rdfs:label "Propane R290"@en .
ex:Nickel a zx:CriticalRawMaterial  ; rdfs:label "Nickel"@en .

ex:Recycled  a zx:OriginType   ; rdfs:label "Recycled content"@en , "Rezyklat"@de .
ex:Renewable a zx:OriginType   ; rdfs:label "Renewable"@en , "erneuerbar"@de .
ex:Reused    a zx:OriginType   ; rdfs:label "Reused"@en , "wiederverwendet"@de .
ex:Separable a zx:PropertyType ; rdfs:label "Cleanly separable"@en , "sortenrein trennbar"@de .
ex:Biodegrad a zx:PropertyType ; rdfs:label "Biodegradable"@en , "biologisch abbaubar"@de .

##  Produkt  ###########################################################

ex:HeatPump-VC300 a zx:Product ;
    zx:productName            "Vitocal 300-A" ;
    zx:costGroup              "410" ;
    zx:productCategory        "Waermeerzeuger" ;
    zx:energyEfficiencyClass  "A+++" ;
    zx:hasIndicatorValue ex:v1 , ex:v2 , ex:v3 , ex:v4 , ex:v5 , ex:v6 ;
    zx:hasMaterialShare  ex:s1 , ex:s2 , ex:s3 , ex:s4 .

##  Indikatorwerte  ####################################################

ex:v1 a zx:IndicatorValue ; zx:forIndicator ex:GWPtotal ;
    zx:numericValue "1842.5"^^xsd:decimal ; zx:hasUnit ex:kgCO2eq ;
    zx:appliesToModule ex:A1-A3 ; zx:hasDeclaredUnit ex:OnePiece .

ex:v2 a zx:IndicatorValue ; zx:forIndicator ex:GWPtotal ;
    zx:numericValue "94.1"^^xsd:decimal ; zx:hasUnit ex:kgCO2eq ;
    zx:appliesToModule ex:C3 ; zx:hasDeclaredUnit ex:OnePiece .

ex:v3 a zx:IndicatorValue ; zx:forIndicator ex:GWPtotal ;
    zx:numericValue "-312.0"^^xsd:decimal ; zx:hasUnit ex:kgCO2eq ;
    zx:appliesToModule ex:D ; zx:hasDeclaredUnit ex:OnePiece .

ex:v4 a zx:IndicatorValue ; zx:forIndicator ex:ODP ;
    zx:numericValue "0.000021"^^xsd:decimal ; zx:hasUnit ex:kgCFC11eq ;
    zx:appliesToModule ex:A1-A3 ; zx:hasDeclaredUnit ex:OnePiece .

ex:v5 a zx:IndicatorValue ; zx:forIndicator ex:RatedPower ;
    zx:numericValue "11.4"^^xsd:decimal ; zx:hasUnit ex:kW .

ex:v6 a zx:IndicatorValue ; zx:forIndicator ex:NetWeight ;
    zx:numericValue "182.0"^^xsd:decimal ; zx:hasUnit ex:kg .

##  Materialanteile  ###################################################

ex:s1 a zx:MaterialShare ; zx:ofMaterial ex:Steel ;
    zx:numericValue "62"^^xsd:decimal ; zx:hasUnit ex:percent ;
    zx:hasShareType ex:Recycled , ex:Separable .

ex:s2 a zx:MaterialShare ; zx:ofMaterial ex:Copper ;
    zx:numericValue "11"^^xsd:decimal ; zx:hasUnit ex:percent ;
    zx:hasShareType ex:Separable .

ex:s3 a zx:MaterialShare ; zx:ofMaterial ex:R290 ;
    zx:numericValue "0.4"^^xsd:decimal ; zx:hasUnit ex:percent .

ex:s4 a zx:MaterialShare ; zx:ofMaterial ex:Nickel ;
    zx:numericValue "0.9"^^xsd:decimal ; zx:hasUnit ex:percent .

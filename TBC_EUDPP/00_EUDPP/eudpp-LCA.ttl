ns0:isDeclared
  a owl:DatatypeProperty ;
  rdfs:label "is declared"@en ;
  rdfs:comment "True if this module value is declared in the study (has a numerical amount), false if the module is explicitly marked as not declared (ND / MND) for this indicator/scenario. Absence of the LCIAModuleValue triple altogether means the module was not in scope of the study (MNA - module not applicable)."@en ;
  rdfs:domain ns0:LCIAModuleValue ;
  rdfs:range xsd:boolean ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:lciaOrInventoryMethodVersion
  a owl:DatatypeProperty ;
  rdfs:label "LCIA or Inventory method version"@en ;
  rdfs:comment "Version of the specific LCIA or Inventory method instance (where applicable). Captures method-instance-level versioning, distinct from methodology-level versioning (eudpp:methodologyVersion on LCIAMethodology). Replaces v1.9.6's efVersion in v1.9.7: EF version is already covered indirectly via the compliance declaration's reference to the appropriate compliance system, while a generic per-method version field is needed."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:licenseType
  a owl:ObjectProperty ;
  rdfs:label "license type"@en ;
  rdfs:comment "License applicable to the LCA / EPD study. Corresponds to ILCD+EPD element publicationAndOwnership/licenseType."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:LicenseType ;
  ns0:ilcdSource "ILCD base" .

ns0:methodology
  a owl:ObjectProperty ;
  rdfs:label "methodology"@en ;
  rdfs:comment "Link from an LCIAOrInventoryMethod to one or several LCIAMethodology individuals it belongs to (e.g. eudpp:methodology_EF3_1). Cardinality 1..n: a single method can be classified into more than one methodology (for example, when two methodologies share the same characterisation factors for one indicator). Replaces the free-text methodology name from v1.9.4 in order to allow structured queries."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:LCIAMethodology ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:methodologyVersion
  a owl:DatatypeProperty ;
  rdfs:label "methodology version"@en ;
  rdfs:comment "Version identifier of an LCIAMethodology individual (e.g. \"3.1\" for EF 3.1, \"2002\" for CML 2002)."@en ;
  rdfs:domain ns0:LCIAMethodology ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:methodology_CML2002
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "CML 2002"@en ;
  rdfs:comment "CML-IA (Institute of Environmental Sciences, Leiden University) baseline 2002 methodology. Used by EN 15804+A1 (predecessor of +A2)."@en ;
  skos:altLabel "CML 2002"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "2002" .

ns0:methodology_EF3_0
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "Environmental Footprint 3.0"@en ;
  rdfs:comment "European Commission Environmental Footprint method, version 3.0. Predecessor of EF 3.1; some characterisation factors differ."@en ;
  skos:altLabel "EF 3.0"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "3.0" .

ns0:methodology_EF3_1
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "Environmental Footprint 3.1"@en ;
  rdfs:comment "European Commission Environmental Footprint method, version 3.1. Mandated by EN 15804+A2 as the characterisation basis for the 13 core and 6 with-caveat impact indicators."@en ;
  skos:altLabel "EF 3.1"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "3.1" .

ns0:methodology_EN15804InventoryRules
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "EN 15804+A2 inventory calculation rules"@en ;
  rdfs:comment "Inventory calculation rules defined by EN 15804+A2 itself for the 18 resource-use / waste / output-flow inventory indicators (PERE, PERM, ... EEE, EET). This \"methodology\" is inventory-level rather than characterised; it is distinguished here from EF 3.1 because the inventory indicators do not use EF characterisation factors."@en ;
  skos:altLabel "EN 15804+A2 inventory"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "A2:2019" .

ns0:methodology_IPCC_AR6
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "IPCC AR6 (GWP)"@en ;
  rdfs:comment "IPCC Sixth Assessment Report (2021) global-warming-potential characterisation factors, 100-year time horizon."@en ;
  skos:altLabel "IPCC AR6"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "AR6 2021" .

ns0:methodology_ReCiPe2016
  a owl:NamedIndividual, ns0:LCIAMethodology ;
  rdfs:label "ReCiPe 2016"@en ;
  rdfs:comment "ReCiPe methodology version 2016 (midpoint and endpoint). Not used by EN 15804+A2 but frequently used for non-construction-products LCAs."@en ;
  skos:altLabel "ReCiPe 2016"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:methodologyVersion "2016" .

ns0:modelName
  a owl:DatatypeProperty ;
  rdfs:label "model name"@en ;
  rdfs:comment "Name of the characterisation model used (e.g. \"IPCC AR6\" for GWP). Corresponds to ILCD+EPD element modelName on impactModel."@en ;
  rdfs:domain ns0:ImpactModel ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

ns0:modelVersion
  a owl:DatatypeProperty ;
  rdfs:label "model version"@en ;
  rdfs:comment "Version of the characterisation model used (e.g. \"IPCC AR6 2021\" vs \"IPCC AR5 2013\", which give different GWP100 values)."@en ;
  rdfs:domain ns0:ImpactModel ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:referenceToBackgroundDatabase
  a owl:ObjectProperty ;
  rdfs:label "reference to background database"@en ;
  rdfs:comment "Link from an LCAStudy to a background LCI database used for the modelling (1..n). Sub-property of eudpp:referenceToDataSource: a background database is a kind of data source, but instances using this more specific property let consumers filter for database-typed sources. NEW in v1.9.7."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:BackgroundDatabase ;
  rdfs:subPropertyOf ns0:referenceToDataSource ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToCompleteReviewReport
  a owl:ObjectProperty ;
  rdfs:label "reference to complete review report"@en ;
  rdfs:comment "Link from a Review to the full review report. Corresponds to ILCD+EPD element review/referenceToCompleteReviewReport."@en ;
  rdfs:domain ns0:Review ;
  rdfs:range ns0:ReviewReport ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToComplianceSystem
  a owl:ObjectProperty ;
  rdfs:label "reference to compliance system"@en ;
  rdfs:comment "Link from a ComplianceDeclaration to the standard or programme it references (EN 15804+A2, ISO 14025, ISO 21930, etc.). Corresponds to ILCD+EPD element compliance/referenceToComplianceSystem."@en ;
  rdfs:domain ns0:ComplianceDeclaration ;
  rdfs:range ns0:ComplianceSystem ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToExternalDocumentation_LCIAOrInventoryMethod
  a owl:ObjectProperty ;
  rdfs:label "reference to external documentation (on LCIA or Inventory method)"@en ;
  rdfs:comment "Link from an LCIAOrInventoryMethod to the external documentation describing the method. Corresponds to ILCD+EPD element referenceToExternalDocumentation on LCIAMethodDataSet/dataSetInformation. Separate from the property eudpp:hasExternalDocumentation which has domain eudpp:LCAStudy. Renamed in v1.9.7 from v1.9.6's referenceToExternalDocumentation_LCIAMethod."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToIncludedMethods
  a owl:ObjectProperty ;
  rdfs:label "reference to included methods"@en ;
  rdfs:comment "Link from a methodology-level LCIAOrInventoryMethod (a collection of methods sharing a methodology such as \"EF 3.1\") to each of the individual-indicator method instances it aggregates. ILCD+EPD LCIA Method Data Sets can represent either a single LCIA or inventory method (one indicator) or a methodology (a collection/list of methods); this property is used only in the latter case. Corresponds to ILCD+EPD element referenceToIncludedMethods."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:LCIAOrInventoryMethod ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToLCIAMethodReport
  a owl:ObjectProperty ;
  rdfs:label "reference to LCIA method report"@en ;
  rdfs:comment "Link from an LCIAOrInventoryMethod to the formal LCIA method report (e.g. the EF 3.1 method description). Specialisation of the more generic eudpp:referenceToExternalDocumentation_LCIAOrInventoryMethod when the documentation is specifically a method-report-typed Source. NEW in v1.9.7."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:LCIAMethodReport ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToModelSource
  a owl:ObjectProperty ;
  rdfs:label "reference to model source"@en ;
  rdfs:comment "Link from an ImpactModel to the bibliographic source(s) describing the characterisation model. Corresponds to ILCD+EPD element referenceToModelSource. Range is eudpp:Source; tighter semantic linking to eudpp:LCIAMethodReport is intended to be enforced via SHACL in a later release."@en ;
  rdfs:domain ns0:ImpactModel ;
  rdfs:range ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToOriginalEPD
  a owl:ObjectProperty ;
  rdfs:label "reference to original EPD"@en ;
  rdfs:comment "Link from the machine-readable EPDStudy to the published EPD document (typically PDF). Corresponds to ILCD+EPD element epd2:referenceToOriginalEPD."@en ;
  rdfs:domain ns0:EPDStudy ;
  rdfs:range ns0:EPDDocument ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:referenceToPCR
  a owl:ObjectProperty ;
  rdfs:label "reference to PCR"@en ;
  rdfs:comment "Link from an EPDStudy to the Product Category Rules document(s) it follows (1..n). Corresponds to ILCD+EPD element referenceToPCR. NEW in v1.9.7."@en ;
  rdfs:domain ns0:EPDStudy ;
  rdfs:range ns0:PCR ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:referenceToPEFCR
  a owl:ObjectProperty ;
  rdfs:label "reference to PEFCR"@en ;
  rdfs:comment "Link from an LCAStudy to a Product Environmental Footprint Category Rules document (1..n). Parallel to referenceToPCR but for PEF studies. NEW in v1.9.7."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:PEFCR ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:referenceYear
  a owl:DatatypeProperty ;
  rdfs:label "reference year"@en ;
  rdfs:comment "Start year of the time period for which the study is valid. Corresponds to ILCD+EPD element time/referenceYear on processDataSet."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range xsd:gYear ;
  ns0:ilcdSource "ILCD base" .

ns0:registrationNumber
  a owl:DatatypeProperty ;
  rdfs:label "registration number"@en ;
  rdfs:comment "Identifying number issued by the EPD programme operator (typically visible on the EPD document). Distinct from the dataset UUID. Corresponds to ILCD+EPD element publicationAndOwnership/registrationNumber."@en ;
  rdfs:domain ns0:EPDStudy ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

ns0:reviewDate
  a owl:DatatypeProperty ;
  rdfs:label "review date"@en ;
  rdfs:comment "Date on which the review was completed. Important for DPP consumers to assess whether the review is still current."@en ;
  rdfs:domain ns0:Review ;
  rdfs:range xsd:date ;
  ns0:ilcdSource "ILCD base" .

ns0:typeOfReview
  a owl:ObjectProperty ;
  rdfs:label "type of review"@en ;
  rdfs:comment "The kind of review performed (independent external, accredited third party, etc.). Corresponds to ILCD+EPD attribute review/@type."@en ;
  rdfs:domain ns0:Review ;
  rdfs:range ns0:TypeOfReview ;
  ns0:ilcdSource "ILCD base" .

ns0:unitAsString
  a owl:AnnotationProperty ;
  rdfs:label "unit as string"@en ;
  rdfs:comment """Human-readable label of the unit in which the associated EN 15804 indicator value is expressed, e.g. "kg CO2-eq", "MJ, net calorific value", "m3". Annotation property (not for automated unit arithmetic).

Pattern for resolving to a machine-readable OM-2 Unit individual (two-step lookup):
STEP 1 - Retrieve the set of Unit individuals in the Ontology of Units of Measure (OM-2, base IRI http://www.ontology-of-units-of-measure.org/resource/om-2/). Each Unit individual carries (i) an rdfs:label (the unit's long English name, e.g. "kilogram"), (ii) an om:symbol datatype property (the standard symbol, e.g. "kg"), and typically (iii) an om:alternativeSymbol or om:alternativeLabel with variants.
STEP 2 - Match the string stored in eudpp:unitAsString against OM-2 via rdfs:label, om:symbol, or om:alternativeSymbol as appropriate. Compound EN 15804 units such as "kg CO2-eq" or "mol H+-eq" are not directly represented as single OM-2 Unit individuals; they should be decomposed (mass in kg, normalized via a characterisation vector) or mapped to an application-specific extension of OM-2. For simple indicators (e.g. FW in m3, SM in kg, HWD in kg, MJ), direct lookup against OM-2 Unit individuals with matching om:symbol works.

Authoritative OM-2 release: om-2.0.rdf, see https://github.com/HajoRijgersberg/OM. Note that the OM-2 property names given here (rdfs:label, om:symbol, om:alternativeSymbol) are stable across the OM 2.0 release. Downstream implementers should verify the exact OM-2 property IRIs against the OM-2 release they use."""@en ;
  ns0:ilcdSource "LCA ontology metadata" .

ns0:uuid
  a owl:DatatypeProperty ;
  rdfs:label "UUID"@en ;
  rdfs:comment "The Universally Unique Identifier of this LCA / EPD study, as mandated by ILCD+EPD as the primary persistent identifier. Once a study is created and a UUID is generated, the UUID stays the same forever; any change increments eudpp:dataSetVersion. String formatted as an RFC 4122 UUID (36 characters, hyphenated)."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

<https://w3id.org/eudpp/LCA>
  a owl:Ontology ;
  rdfs:label "EU DPP LCA"@en ;
  dcterms:created "2026-06-02"^^xsd:date ;
  dcterms:creator "Marc-Andree Wolf"@en ;
  dcterms:description """
LCA (Life Cycle Assessment) module of an EU DPP (Digital Product Passport) core ontology proposal of the CIRPASS-2 European project.

SCOPE
This module is derived from the ILCD+EPD v1.3 data format (https://indatawg.github.io/ILCD-EPD-Data-Format/) and covers environmental-performance metadata that a DPP needs to carry. It supports both (a) general LCA studies of any product, expressed via eudpp:LCAStudy, and (b) Environmental Product Declarations (EPDs) conforming to EN 15804+A2 with EF 3.1 characterisation, expressed via eudpp:EPDStudy (a subclass of LCAStudy). The scope is deliberately lean: only metadata required for unambiguous identification of the study, its compliance status (where applicable), and its headline LCIA results (eudpp:LCIAResult: characterised impact results) and aggregated inventory-indicator results (eudpp:InventoryIndicatorResult: per-indicator aggregates per EN 15804+A2 Table 5) per life-cycle module and per scenario are modelled. Note that eudpp:InventoryIndicatorResult represents the AGGREGATED inventory-indicator value as printed in EN 15804+A2 EPD tables (e.g. total kg of HWD across A1-A3); it is NOT the raw flow-level life-cycle inventory (LCI) of a process. Full ILCD+EPD elements that are not needed for DPP use cases (exchanges/elementary flows, scenario quantities, variability/safety-margins sub-blocks, normalisation/weighting, characterisation-factor tables, etc.) are intentionally omitted in this release. Some fields from ILCD+EPD that describe the declared product rather than the LCA study (product identifiers, content declaration, service-life sub-structure) are handled by sibling modules of the CIRPASS-2 DPP core ontology (P_DPP, SOC) and are not redefined here.

NAMESPACE
All terms in this module live under the family-wide EUDPP namespace https://w3id.org/eudpp# (matching ACTOR, P_DPP, SOC, CONNECTOR). The ontology IRI itself is https://w3id.org/eudpp/LCA. There is no per-module term prefix.

PROVENANCE OF TERMS
Every class, property and named individual in this ontology carries an eudpp:ilcdSource annotation with one of: "ILCD base" (originates from the ILCD 1.1 base data format), "ILCD+EPD extension" (originates from the ILCD+EPD v1.3 extension, i.e. the epd, epd2, epd24 namespaces of InData), "LCA ontology extension" (introduced by this module without direct ILCD/ILCD+EPD counterpart), or "LCA ontology metadata" (annotation properties used internally by this module). This allows downstream systems to distinguish which parts of the ontology are generic LCA metadata and which are EPD-specific.

DEPENDENCIES
This module imports the ACTOR module of the CIRPASS-2 EU DPP Core Ontology (https://w3id.org/eudpp/ACTOR) for its eudpp:Actor and eudpp:Facility classes. It also references, but does not import, the Ontology of Units of Measure (OM-2; http://www.ontology-of-units-of-measure.org/resource/om-2/) for units. Cross-module object properties whose domain is in this module and whose range is in another EUDPP module (Actor, Facility, Product, DPP) are NOT defined here; per the EU DPP Core Ontology design principles, they are defined in the CONNECTOR module. The full list of Connector entries that this module expects is given in the per-class comments below.

HARD-CODED INDICATOR SETS
Two indicator sets are declared as named individuals: (i) 37 EN 15804+A2 EF 3.1 indicators (13 core impact + 6 impact with-caveats + 18 resource-use, waste and output-flow inventory indicators), used by EN 15804+A2 EPDStudy instances; and (ii) 16 EF 3.1 / PEF impact categories, used by general LCAStudy instances following the EU Environmental Footprint method. The two sets overlap in concept but differ in operational form (EN 15804+A2 splits Climate change into four sub-indicators and selects a different "with caveats" subset; EF 3.1 keeps the 16 PEF categories at one level of aggregation). Additional LCIA methodologies and results can be added by instantiating eudpp:LCIAOrInventoryMethod and eudpp:LCAResult (or its subclasses eudpp:LCIAResult and eudpp:InventoryIndicatorResult) without modifying this ontology.

REFERENCE
For more information, see Maigre, R., Haav, H.-M., Robal, T., Wolf, M.-A., and Danash, F. (2025). Ontology Requirements Specification for an EU DPP Core Ontology Proposal (1.1). CIRPASS-2 Consortium. https://doi.org/10.5281/zenodo.15270342
    """@en ;
  dcterms:issued "2026-06-02"^^xsd:date ;
  dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>, "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
  dcterms:title "LCA module of the CIRPASS-2 EU DPP Core Ontology"@en ;
  ns1:preferredNamespacePrefix "eudpp" ;
  ns1:preferredNamespaceUri "https://w3id.org/eudpp#" ;
  rdfs:comment "The LCA module of the EU DPP core ontology, version 2.0."@en ;
  rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/>, <https://standards.cen.eu/dyn/www/f?p=204:110:0::::FSP_PROJECT:65243> ;
  owl:priorVersion <https://w3id.org/eudpp/LCA/1.9.7> ;
  owl:versionIRI <https://w3id.org/eudpp/LCA/2.0> ;
  owl:versionInfo "2.0" .

<http://www.ontology-of-units-of-measure.org/resource/om-2/Unit>
  a owl:Class ;
  rdfs:comment "Externally defined class imported by reference from OM-2 (Ontology of Units of Measure). Used as the range of eudpp:hasUnit. OM-2 is not imported via owl:imports to avoid transitive closure of a large external ontology; implementers needing unit-based reasoning should load OM-2 separately alongside this ontology."@en ;
  rdfs:isDefinedBy <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

xsd:gYear a rdfs:Datatype .
ns0:BackgroundDatabase
  a owl:Class ;
  rdfs:label "Background Database"@en ;
  rdfs:comment "Source representing a background LCI database used for the LCA modelling (e.g. ecoinvent, GaBi/Sphera, Okobaudat)."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:ComplianceSystem
  a owl:Class ;
  rdfs:label "Compliance System"@en ;
  rdfs:comment "A standard or programme against which an LCA or EPD study is declared compliant, such as ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR programmes, or a specific programme operator's scheme."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:EPDDocument
  a owl:Class ;
  rdfs:label "EPD Document"@en ;
  rdfs:comment "Source representing the published PDF or HTML EPD document itself (as distinct from the ILCD+EPD machine-readable EPDStudy)."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:EnvironmentalFootprintScore
  a owl:Class ;
  rdfs:label "Environmental Footprint Score"@en ;
  rdfs:comment "An aggregated single-score indicator computed as the normalised and weighted sum of a set of impact-category results. Direct subclass of eudpp:LCIAIndicator (sibling of eudpp:EN15804Indicator and eudpp:LCIAImpactIndicator), distinct from those because the single score is a derived aggregate and not itself an impact category. Holds one named individual eudpp:ind_EF_singleScore representing the EU Environmental Footprint single score (PEF score). The applied normalisation factors and weighting set are not modelled here as properties; they are determined by the active EF / PEF methodology version, which is resolvable via the study's eudpp:hasComplianceDeclaration link to a eudpp:ComplianceSystem source. Results computed for an EnvironmentalFootprintScore individual are eudpp:LCIAResult instances. NEW class introduced in v1.9.7."@en ;
  rdfs:subClassOf ns0:LCIAIndicator ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:InventoryIndicatorResult
  a owl:Class ;
  rdfs:label "Inventory Indicator Result"@en ;
  rdfs:comment "Aggregated inventory-indicator result computed for an EN 15804+A2 inventory indicator (Table 5: resource use, waste categories, output flows). Sibling of eudpp:LCIAResult. Structurally identical to LCIAResult (per-module, per-scenario numerical values via eudpp:LCIAModuleValue). Important disambiguation: this class represents the AGGREGATED inventory-indicator value (e.g. total kg of HWD across A1-A3 for one product), as printed in EN 15804+A2 EPD tables and computed by an LCIAOrInventoryMethod instance. It is NOT the raw flow-level life-cycle inventory (LCI) result of a process (which would be a list of elementary-flow exchanges with amounts and units, and is out of scope for this DPP-oriented LCA module). Renamed in v1.9.7 from v1.9.6's eudpp:InventoryResult to make this distinction explicit. Distinguishing impact-result and inventory-indicator-result as siblings under a common eudpp:LCAResult parent reflects the conceptual distinction in EN 15804+A2 between Tables 3/4 (impact) and Table 5 (inventory) and supports separate downstream rendering in standard EPD tables."@en ;
  rdfs:subClassOf ns0:LCAResult ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:LCIAMethodReport
  a owl:Class ;
  rdfs:label "LCIA Method Report"@en ;
  rdfs:comment "Source that documents a life-cycle impact assessment (LCIA) method (e.g. the EF 3.1 method description)."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:LCIAResult
  a owl:Class ;
  rdfs:label "LCIA Result"@en ;
  rdfs:comment "Characterised life-cycle impact assessment result of applying one LCIAOrInventoryMethod to the inventory of an LCA or EPD study. Carries per-life-cycle-module and per-scenario numerical values (via eudpp:LCIAModuleValue). Sibling of eudpp:InventoryIndicatorResult. Corresponds to ILCD+EPD element LCIAResults/LCIAResult when the indicator is a characterised impact indicator."@en ;
  rdfs:subClassOf ns0:LCAResult ;
  ns0:ilcdSource "ILCD base" .

ns0:ManufacturerRecord
  a owl:Class ;
  rdfs:label "Manufacturer Record"@en ;
  rdfs:comment "A container that pairs one manufacturing Actor (via the Connector property identifiesManufacturer) with one or more manufacturing Facilities (via the Connector property hasManufacturingSite) for the product covered by an LCAStudy or its EPDStudy subclass. Corresponds to ILCD+EPD element epd24:manufacturer inside epd24:manufacturers. The ACTOR module does not model an actor-facility relationship natively, so this wrapper class is retained."@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:PCR
  a owl:Class ;
  rdfs:label "Product Category Rules (PCR)"@en ;
  rdfs:comment "Source that is a Product Category Rules document (EN 15804+A2 Table 2 Line 1). Used in EN 15804+A2 EPDStudy via eudpp:referenceToPCR."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:PEFCR
  a owl:Class ;
  rdfs:label "Product Environmental Footprint Category Rules (PEFCR)"@en ;
  rdfs:comment "Source that is a Product Environmental Footprint Category Rules document, the European Commission Environmental Footprint methodology's product-category-specific rules. Parallel role to PCR but for PEF studies (rather than EN 15804+A2 EPD studies). Used by an LCAStudy via eudpp:referenceToPEFCR. NEW in v1.9.7."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:ReviewReport
  a owl:Class ;
  rdfs:label "Review Report"@en ;
  rdfs:comment "Source holding the complete critical-review / verification report referenced from a Review."@en ;
  rdfs:subClassOf ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:accreditedThirdPartyReview
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Accredited third party review"@en ;
  rdfs:comment "Reviewer independent of the organisations involved and accredited by an independent accreditation body. Highest level acceptable for EN 15804+A2 compliance."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:acidification
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Acidification"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:aopHumanHealth
  a owl:NamedIndividual, ns0:AreaOfProtection ;
  rdfs:label "Human health"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:aopManMadeEnvironment
  a owl:NamedIndividual, ns0:AreaOfProtection ;
  rdfs:label "Man-made environment"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:aopNaturalEnvironment
  a owl:NamedIndividual, ns0:AreaOfProtection ;
  rdfs:label "Natural environment"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:aopNaturalResources
  a owl:NamedIndividual, ns0:AreaOfProtection ;
  rdfs:label "Natural resources"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:aopOther
  a owl:NamedIndividual, ns0:AreaOfProtection ;
  rdfs:label "Other"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:climateChange
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Climate change"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:dependentInternalReview
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Dependent internal review"@en ;
  rdfs:comment "Reviewer involved in data collection or modelling, or representing the process/product system. Not acceptable for EN 15804+A2 compliance."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:eutrophication
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Eutrophication"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:forIndicator
  a owl:ObjectProperty ;
  rdfs:label "for indicator"@en ;
  rdfs:comment "Link from an LCIAOrInventoryMethod to the LCIAIndicator individual that it computes (typically an EN15804Indicator individual; for non-EN-15804 LCA studies, any LCIAIndicator individual). This is the key identity of an ILCD+EPD LCIA Method Data Set. Cardinality is at most 1 per method instance (enforced via owl:Restriction on LCIAOrInventoryMethod). Range generalised in v1.9.7 from EN15804Indicator to LCIAIndicator so non-EN-15804 indicators can be referenced."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:LCIAIndicator ;
  ns0:ilcdSource "ILCD base" .

ns0:freeOfChargeAll
  a owl:NamedIndividual, ns0:LicenseType ;
  rdfs:label "Free of charge for all users and uses"@en ;
  rdfs:comment "The study can be freely accessed and used by all user types and for all uses, including commercial."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:freeOfChargeMembers
  a owl:NamedIndividual, ns0:LicenseType ;
  rdfs:label "Free of charge for members only"@en ;
  rdfs:comment "The study is accessible free of charge only to members of the dataset owner's organisation."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:freeOfChargeSome
  a owl:NamedIndividual, ns0:LicenseType ;
  rdfs:label "Free of charge for some user types or use types"@en ;
  rdfs:comment "The study can be accessed free of charge for certain user types or uses."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:freshwaterEcotoxicity
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Freshwater ecotoxicity"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:fullyCompliant
  a owl:NamedIndividual, ns0:ComplianceStatus ;
  rdfs:label "Fully compliant"@en ;
  rdfs:comment "The EPD study is declared fully compliant with the referenced compliance system."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:humanToxicity
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Human toxicity"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:independentExternalReview
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Independent external review"@en ;
  rdfs:comment "Reviewer independent of the organisations involved. Acceptable for EN 15804+A2 compliance."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:independentInternalReview
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Independent internal review"@en ;
  rdfs:comment "Reviewer not involved in the work but belonging to the same organisation or legally linked organisation. Acceptable only for generic data per InData."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:independentReviewPanel
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Independent review panel"@en ;
  rdfs:comment "Panel of at least three independent internal or external reviewers, chaired by an independent external reviewer."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:ionisingRadiationEcosystems
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Ionising radiation, ecosystems"@en ;
  rdfs:comment "Ionising radiation on ecosystems. Note: EN 15804+A2 does not mandate an ecosystems-level ionising-radiation indicator (only IRP for human health). This impact category is retained for ILCD completeness; no EN 15804+A2 indicator individual maps to it."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:ionisingRadiationHumanHealth
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Ionising radiation, human health"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:landUseSoilQuality
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Land use / soil quality"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:licenseFee
  a owl:NamedIndividual, ns0:LicenseType ;
  rdfs:label "License fee"@en ;
  rdfs:comment "The study is accessible for a license fee."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:licenseOther
  a owl:NamedIndividual, ns0:LicenseType ;
  rdfs:label "Other"@en ;
  rdfs:comment "Other licensing conditions apply; see accessRestrictions for details."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:marineEcotoxicity
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Marine ecotoxicity"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:moduleA1
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A1 - Raw material extraction and supply"@en ;
  skos:altLabel "A1"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleA1A3
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A1-A3 - Product stage (aggregated)"@en ;
  skos:altLabel "A1-A3"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleA2
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A2 - Transport to manufacturer"@en ;
  skos:altLabel "A2"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleA3
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A3 - Manufacturing"@en ;
  skos:altLabel "A3"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleA4
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A4 - Transport to building site"@en ;
  skos:altLabel "A4"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleA5
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "A5 - Construction / installation"@en ;
  skos:altLabel "A5"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB1
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B1 - Use"@en ;
  skos:altLabel "B1"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB2
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B2 - Maintenance"@en ;
  skos:altLabel "B2"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB3
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B3 - Repair"@en ;
  skos:altLabel "B3"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB4
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B4 - Replacement"@en ;
  skos:altLabel "B4"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB5
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B5 - Refurbishment"@en ;
  skos:altLabel "B5"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB6
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B6 - Operational energy use"@en ;
  skos:altLabel "B6"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleB7
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "B7 - Operational water use"@en ;
  skos:altLabel "B7"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleC1
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "C1 - Deconstruction / demolition"@en ;
  skos:altLabel "C1"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleC2
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "C2 - Transport to waste processing"@en ;
  skos:altLabel "C2"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleC3
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "C3 - Waste processing"@en ;
  skos:altLabel "C3"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleC4
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "C4 - Disposal"@en ;
  skos:altLabel "C4"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:moduleD
  a owl:NamedIndividual, ns0:LifeCycleModule ;
  rdfs:label "D - Benefits and loads beyond the system boundary"@en ;
  skos:altLabel "D"@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:notCompliant
  a owl:NamedIndividual, ns0:ComplianceStatus ;
  rdfs:label "Not compliant"@en ;
  rdfs:comment "The EPD study is declared not compliant with the referenced compliance system."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:notReviewed
  a owl:NamedIndividual, ns0:TypeOfReview ;
  rdfs:label "Not reviewed"@en ;
  rdfs:comment "The dataset has not been reviewed."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:ozoneDepletion
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Ozone depletion"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:partiallyCompliant
  a owl:NamedIndividual, ns0:ComplianceStatus ;
  rdfs:label "Partially compliant"@en ;
  rdfs:comment "The EPD study is declared partially compliant with the referenced compliance system; deviations should be documented on the associated review or in accessRestrictions."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:photochemicalOzoneFormation
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Photochemical ozone formation"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:referenceToDataSource
  a owl:ObjectProperty ;
  rdfs:label "reference to data source"@en ;
  rdfs:comment "Link from an LCAStudy to the background database(s) or literature source(s) used for modelling. Corresponds to ILCD+EPD element referenceToDataSource (e.g. ecoinvent, GaBi/Sphera, Okobaudat)."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:resourceUseFossil
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Resource use, fossil"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:resourceUseMineralsMetals
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Resource use, minerals and metals"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:respiratoryInorganics
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Respiratory inorganics / particulate matter"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:terrestrialEcotoxicity
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Terrestrial ecotoxicity"@en ;
  ns0:ilcdSource "ILCD base" .

ns0:waterUseDeprivation
  a owl:NamedIndividual, ns0:LCIAImpactCategory ;
  rdfs:label "Water use / water deprivation"@en ;
  ns0:ilcdSource "ILCD base" .

xsd:date a rdfs:Datatype .
ns0:hasLCAResult
  a owl:ObjectProperty ;
  rdfs:label "has LCA result"@en ;
  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to one of its LCA results. Range is the abstract eudpp:LCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryResult narrow the result to the corresponding sibling subclass. Querying for eudpp:hasLCAResult retrieves both kinds of results in one go."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:LCAResult ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:ComplianceDeclaration
  a owl:Class ;
  rdfs:label "Compliance Declaration"@en ;
  rdfs:comment "A statement that the LCA or EPD study complies with a given compliance system (typically ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, or a PEFCR). Corresponds to ILCD+EPD element complianceDeclarations/compliance. The level of compliance (fully, partially, not compliant) is recorded via eudpp:complianceStatus."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:EN15804Indicator
  a owl:Class ;
  rdfs:label "EN 15804 Indicator"@en ;
  rdfs:comment "An indicator defined by EN 15804+A2 (core impact, impact with caveats, resource use, waste output, or output-flow indicator). Subclass of the abstract eudpp:LCIAIndicator parent. Named individuals of this class (and its subclasses) are used as the indicator that an eudpp:LCIAOrInventoryMethod calculates values for. Note: an EN15804Indicator individual is the indicator definition; a result computed for that indicator is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult sibling)."@en ;
  rdfs:subClassOf ns0:LCIAIndicator ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:group_exportedEnergy
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "exported energy"@en ;
  rdfs:comment "Exported-energy inventory indicators of EN 15804+A2 (electrical energy, thermal energy)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:ComplianceStatus
  a owl:Class ;
  rdfs:label "Compliance Status"@en ;
  rdfs:comment "Level of compliance declared by a ComplianceDeclaration relative to its compliance system. Enumeration of 3 named individuals (fullyCompliant, partiallyCompliant, notCompliant)."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:fullyCompliant
     ns0:notCompliant
     ns0:partiallyCompliant
   )
  ] ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:ImpactModel
  a owl:Class ;
  rdfs:label "Impact Model"@en ;
  rdfs:comment "The characterisation model underlying an LCIA method (e.g. IPCC AR6 2021 for GWP). Corresponds to ILCD+EPD element impactModel of an LCIA Method Data Set. Carries a model name (eudpp:modelName), optional version (eudpp:modelVersion), and optional bibliographic source (eudpp:referenceToModelSource)."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:LCIAIndicator
  a owl:Class ;
  rdfs:label "LCIA Indicator"@en ;
  rdfs:comment "Abstract umbrella class for an indicator definition (impact or inventory category) that an eudpp:LCIAOrInventoryMethod calculates values for. Parent of eudpp:EN15804Indicator (which holds the EN 15804+A2 indicator definitions). For non-EN-15804 LCA studies (e.g. PEF, ISO 14067 carbon footprint), additional indicator individuals can be added as direct instances of LCIAIndicator or via further subclasses without modifying this ontology. Note: an indicator individual is the indicator DEFINITION (e.g. \"FW – Net use of fresh water, in m3\"); a numerical value computed for that indicator on a specific study is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult). NEW in v1.9.7."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:Review
  a owl:Class ;
  rdfs:label "Review"@en ;
  rdfs:comment "A verification / critical review performed on an LCA study or EPD study. Corresponds to ILCD+EPD element validation/review."@en ;
  rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/doc/> ;
  ns0:ilcdSource "ILCD base" .

ns0:group_valorisation
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "valorisation"@en ;
  rdfs:comment "Valorisation-output inventory indicators of EN 15804+A2 (components for re-use, materials for recycling, materials for energy recovery)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:group_waste
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "waste"@en ;
  rdfs:comment "Waste-output inventory indicators of EN 15804+A2 (hazardous, non-hazardous, radioactive waste disposed)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:EPDStudy
  a owl:Class ;
  rdfs:label "EPD-Studie"@de, "EPD Study"@en ;
  rdfs:comment "An LCA study that conforms to EN 15804+A2 with EF 3.1 characterisation, i.e. an Environmental Product Declaration. Inherits all study-level metadata from eudpp:LCAStudy (compliance declarations, manufacturer records, reviews, LCA results, etc.) and adds EPD-specific properties: ILCD+EPD format version (eudpp:epdFormatVersion), registration number, expiry date, reference to the published EPD document (eudpp:EPDDocument via referenceToOriginalEPD), reference to the applicable Product Category Rules (eudpp:PCR via referenceToPCR). EN 15804+A2 module values per LCAResult are used to populate per-life-cycle-module values. Replaces v1.9.4's mixed structure and v1.9.5's eudpp:EPDDataSet."@en ;
  rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/doc/> ;
  rdfs:subClassOf ns0:LCAStudy ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:LCAResult
  a owl:Class ;
  rdfs:label "LCA Result"@en ;
  rdfs:comment "Abstract umbrella class for any LCA computation output of a study. Has two siblings as concrete subclasses: eudpp:LCIAResult (characterised impact result) and eudpp:InventoryIndicatorResult (aggregated inventory-indicator result). Both are produced from the same life-cycle inventory but via different calculation paths: LCIAResult applies characterisation factors of an LCIA method, InventoryIndicatorResult is a sum/aggregation over the inventory without characterisation. Both are computed by an eudpp:LCIAOrInventoryMethod (the unified method class). Connected to LCAStudy via eudpp:hasLCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryIndicatorResult narrow the result type."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:LCIAModuleValue
  a owl:Class ;
  rdfs:label "LCIA Module Value"@en ;
  rdfs:comment "One numerical LCA-result value (impact or inventory-indicator) for a specific EN 15804+A2 life-cycle module (A1-A3, A4, ..., D) and optionally a specific scenario. Carries eudpp:amount (the numeric value), eudpp:forModule, optionally eudpp:forScenario, and eudpp:isDeclared (boolean: true if the module is declared with this value; false if the module is explicitly not declared for this indicator). Used by both eudpp:LCIAResult and eudpp:InventoryIndicatorResult instances. Corresponds to ILCD+EPD element epd:amount inside LCIAResult/other."@en ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:AreaOfProtection
  a owl:Class ;
  rdfs:label "Area of Protection"@en ;
  rdfs:comment "Damage area addressed by an LCIA method (only used for damage/end-point methods). Enumeration matching ILCD AreaOfProtectionValues."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:aopHumanHealth
     ns0:aopManMadeEnvironment
     ns0:aopNaturalEnvironment
     ns0:aopNaturalResources
     ns0:aopOther
   )
  ] ;
  ns0:ilcdSource "ILCD base" .

ns0:LicenseType
  a owl:Class ;
  rdfs:label "License Type"@en ;
  rdfs:comment "License applicable to access and use of the LCA / EPD study. Enumeration matching ILCD LicenseTypeValues."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:freeOfChargeAll
     ns0:freeOfChargeMembers
     ns0:freeOfChargeSome
     ns0:licenseFee
     ns0:licenseOther
   )
  ] ;
  ns0:ilcdSource "ILCD base" .

ns0:EN15804IndicatorGroup
  a owl:Class ;
  rdfs:label "EN 15804 Indicator Group"@en ;
  rdfs:comment "Grouping of the EN 15804+A2 indicators as printed in the standard's tables: core impact (Table 3), impact indicators with caveats (Table 4), resource use (Table 5 resource use), waste categories (Table 5 waste), output flows valorisation (Table 5 output flows), exported energy (Table 5 output flows). Enumeration of 6 named individuals."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:group_coreImpact
     ns0:group_exportedEnergy
     ns0:group_resourceUse
     ns0:group_valorisation
     ns0:group_waste
     ns0:group_withCaveats
   )
  ] ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:TypeOfReview
  a owl:Class ;
  rdfs:label "Type of Review"@en ;
  rdfs:comment "Kind of critical-review/verification performed on a dataset. Enumeration matching ILCD TypeOfReviewValues."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:accreditedThirdPartyReview
     ns0:dependentInternalReview
     ns0:independentExternalReview
     ns0:independentInternalReview
     ns0:independentReviewPanel
     ns0:notReviewed
   )
  ] ;
  ns0:ilcdSource "ILCD base" .

ns0:group_withCaveats
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "impact with caveats"@en ;
  rdfs:comment "Additional 6 characterised impact indicators of EN 15804+A2 that must be reported with the standard caveat statement (Table 4)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:LCIAMethodology
  a owl:Class ;
  rdfs:label "LCIA Methodology"@en ;
  rdfs:comment "A named, versioned LCIA methodology (a coherent set of LCIA methods sharing principles and a set of characterisation factors), to which one or more LCIAMethod instances belong. The enumeration below is seeded with six commonly-used methodologies in EPD practice and is intentionally NOT closed via owl:oneOf: new methodology individuals can be added by instantiating LCIAMethodology without modifying this ontology. Each individual SHOULD carry a skos:altLabel giving a short code (e.g. \"EF 3.1\") and eudpp:methodologyVersion giving the version identifier."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:LCIAOrInventoryMethod
  a owl:Class ;
  rdfs:label "LCIA or Inventory Method"@en ;
  rdfs:comment "A life-cycle method that produces values for one indicator from an inventory of elementary flows. Covers two cases: (a) characterised LCIA methods (which apply characterisation factors to compute a midpoint impact result), and (b) inventory aggregation methods (which sum / aggregate inventory flows to produce an inventory-indicator result, e.g. the EN 15804+A2 inventory indicators FW, HWD, PERE etc. defined as inventory-level by the standard's calculation rules). Corresponds to ILCD+EPD LCIA Method Data Set, which is used in practice for both kinds. Each instance identifies exactly one indicator (the ILCD+EPD pattern uses one LCIAMethodDataSet per indicator); this constraint is formalised as owl:maxCardinality 1 on eudpp:forIndicator. A methodology (in the ILCD sense of a set of methods sharing principles and characterisation factors) is represented by the object property eudpp:methodology, which can map a single method to one or several methodology individuals (1..n cardinality). ILCD+EPD LCIA Method Data Sets can also represent a methodology (a collection of methods); in that aggregator role, the LCIAOrInventoryMethod instance does not set forIndicator but uses eudpp:referenceToIncludedMethods to point to the per-indicator method instances. Renamed in v1.9.7 from v1.9.6's eudpp:LCIAMethod (the old name was misleading; in EPD/LCA software practice the same \"method\" object computes either characterised impacts or inventory aggregates)."@en ;
  rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/gitBranches/release/v1.3/schemadoc/ILCD_LCIAMethodDataSet.html> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty ns0:forIndicator
  ] ;
  ns0:ilcdSource "ILCD base" .

ns0:Source
  a owl:Class ;
  rdfs:label "Source"@en ;
  rdfs:comment "A bibliographic or documentary source referenced from an LCA study, EPD study or LCIA Method. Abstract superclass; concrete source instances typically use one of the more specific subclasses (PCR, LCIAMethodReport, BackgroundDatabase, ComplianceSystem, ReviewReport, EPDDocument). Corresponds to ILCD+EPD Source Data Set."@en ;
  ns0:ilcdSource "ILCD base" .

ns0:group_resourceUse
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "resource use"@en ;
  rdfs:comment "Resource-use inventory indicators of EN 15804+A2 (primary energy, secondary materials, secondary fuels, water)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:group_coreImpact
  a owl:NamedIndividual, ns0:EN15804IndicatorGroup ;
  rdfs:label "core impact"@en ;
  rdfs:comment "Core set of 13 characterised impact indicators mandatory for EN 15804+A2 EPDs (Table 3)."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:LCIAImpactIndicator
  a owl:Class ;
  rdfs:label "LCIA Impact Indicator"@en ;
  rdfs:comment "A characterised impact indicator outside the EN 15804+A2 selection — direct subclass of eudpp:LCIAIndicator, sibling of eudpp:EN15804Indicator. Holds the 16 official EF 3.1 / PEF impact category indicators as named individuals (Andreasi Bassi et al., JRC, 2023). These are the impact indicators used by general LCA studies (eudpp:LCAStudy) following the EU Environmental Footprint method, distinct from the EN 15804+A2 set used by EPDStudy. The two sets overlap conceptually — both have e.g. a \"Climate change\" indicator with kg CO2-eq — but differ operationally: EN 15804+A2 splits Climate change into four sub-indicators (total, fossil, biogenic, luluc) and selects 6 \"with caveats\" indicators with EN-specific reporting rules; EF 3.1 keeps Climate change as one indicator and presents 16 categories at one aggregation level. An LCIAOrInventoryMethod can reference indicators from either set via eudpp:forIndicator. Results computed for an LCIAImpactIndicator are eudpp:LCIAResult instances. Results expressed in dimensionless / Pt for land use are recorded with their numerical value in eudpp:amount."@en ;
  rdfs:subClassOf ns0:LCIAIndicator ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:EN15804InventoryIndicator
  a owl:Class ;
  rdfs:label "EN 15804 Inventory Indicator"@en ;
  rdfs:comment "An EN 15804+A2 inventory-level indicator (resource use, waste disposed, or output flow for valorisation / exported energy). Not characterised; value is an aggregated inventory quantity. Results computed for this indicator are eudpp:InventoryIndicatorResult instances."@en ;
  rdfs:subClassOf ns0:EN15804Indicator ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:LCIAImpactCategory
  a owl:Class ;
  rdfs:label "LCIA Impact Category"@en ;
  rdfs:comment "A mid-point impact category that an LCIAMethod addresses. Enumeration matching ILCD LCIAImpactCategoryValues."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:acidification
     ns0:climateChange
     ns0:eutrophication
     ns0:freshwaterEcotoxicity
     ns0:humanToxicity
     ns0:ionisingRadiationEcosystems
     ns0:ionisingRadiationHumanHealth
     ns0:landUseSoilQuality
     ns0:marineEcotoxicity
     ns0:ozoneDepletion
     ns0:photochemicalOzoneFormation
     ns0:resourceUseFossil
     ns0:resourceUseMineralsMetals
     ns0:respiratoryInorganics
     ns0:terrestrialEcotoxicity
     ns0:waterUseDeprivation
   )
  ] ;
  ns0:ilcdSource "ILCD base" .

ns0:EN15804ImpactIndicator
  a owl:Class ;
  rdfs:label "EN 15804 Impact Indicator"@en ;
  rdfs:comment "An EN 15804+A2 characterised impact indicator (core set of 13 or the 6 additional \"with caveats\" indicators). Characterised via the EF 3.1 characterisation models. Results computed for this indicator are eudpp:LCIAResult instances."@en ;
  rdfs:subClassOf ns0:EN15804Indicator ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:LCAStudy
  a owl:Class ;
  rdfs:label "LCA Study"@en ;
  rdfs:comment "A life-cycle assessment study of a product, conducted per ISO 14040/14044, producing one or more LCA results (eudpp:LCAResult, with subclasses eudpp:LCIAResult for characterised impact results and eudpp:InventoryIndicatorResult for aggregated inventory-indicator results). The general study container, applicable to any product whether or not the study follows EN 15804+A2. Construction-products EPDs use the subclass eudpp:EPDStudy. Carries study-level metadata (UUID, dataset version, name, reference year, license, copyright, ILCD format version, compliance declarations, manufacturer records, reviews, references to data sources / background databases / PEFCR, etc.). Cross-module link from a product to this class is provided by the Connector property eudpp:hasLCAStudy."@en ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:LifeCycleModule
  a owl:Class ;
  rdfs:label "Life Cycle Module"@en ;
  rdfs:comment "A modelled life-cycle module per EN 15804+A2 (product stage A1-A3, construction A4-A5, use stage B1-B7, end-of-life C1-C4, benefits/loads D). Enumeration of 18 named individuals. Note that moduleA1A3 (aggregated product stage) is an alternative reporting form of A1+A2+A3; an EPD that reports A1-A3 should not additionally report A1, A2, A3 separately for the same indicator/scenario."@en ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     ns0:moduleA1
     ns0:moduleA1A3
     ns0:moduleA2
     ns0:moduleA3
     ns0:moduleA4
     ns0:moduleA5
     ns0:moduleB1
     ns0:moduleB2
     ns0:moduleB3
     ns0:moduleB4
     ns0:moduleB5
     ns0:moduleB6
     ns0:moduleB7
     ns0:moduleC1
     ns0:moduleC2
     ns0:moduleC3
     ns0:moduleC4
     ns0:moduleD
   )
  ] ;
  ns0:ilcdSource "ILCD+EPD extension" .


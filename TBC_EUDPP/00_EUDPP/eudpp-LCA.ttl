@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ns0: <https://w3id.org/eudpp#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ns1: <http://purl.org/vocab/vann/> .

dcterms:accessRights a owl:AnnotationProperty .
dcterms:bibliographicCitation a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:issued a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .
<http://purl.org/vocab/vann/preferredNamespacePrefix> a owl:AnnotationProperty .
<http://purl.org/vocab/vann/preferredNamespaceUri> a owl:AnnotationProperty .
owl:priorVersion a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .
<https://w3id.org/eudpp#accessRestrictions>
  a owl:DatatypeProperty ;
  rdfs:label "access restrictions"@en ;
  rdfs:comment "Human-readable description of access and use restrictions for the LCA / EPD study (equivalent to dcterms:accessRights). Corresponds to ILCD+EPD element accessRestrictions."@en ;
  rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
  rdfs:range rdf:langString ;
  ns0:ilcdSource "ILCD base" .

ns0:amount
  a owl:DatatypeProperty ;
  rdfs:label "amount"@en ;
  rdfs:comment "Numerical value of an LCIAModuleValue, in the unit given by the associated LCIAMethod. Corresponds to ILCD+EPD text content of epd:amount inside LCIAResult/other."@en ;
  rdfs:domain ns0:LCIAModuleValue ;
  rdfs:range xsd:double ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:areaOfProtection
  a owl:ObjectProperty ;
  rdfs:label "area of protection"@en ;
  rdfs:comment "Area-of-protection addressed by an LCIAImpactCategory (1..n cardinality: a single impact category can address several Areas of Protection — for example, ozone depletion affects both Natural Environment and Human Health). Domain moved in v1.9.7 from LCIAOrInventoryMethod to LCIAImpactCategory: ontologically AoP is a property of the impact category, not of the calculator that addresses it; different methods for the same impact category share the same AoPs. This deviates from the ILCD serialisation pattern (which puts areaOfProtection on LCIAMethodDataSet) for ontological correctness; the ILCD value can still be derived by following impactCategory then areaOfProtection."@en ;
  rdfs:domain ns0:LCIAImpactCategory ;
  rdfs:range ns0:AreaOfProtection ;
  ns0:ilcdSource "ILCD base" .

ns0:baseName
  a owl:DatatypeProperty ;
  rdfs:label "base name"@en ;
  rdfs:comment "General descriptive name of the product or system represented by the study. Multilingual. Corresponds to ILCD+EPD element processInformation/dataSetInformation/name/baseName."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range rdf:langString ;
  ns0:ilcdSource "ILCD base" .

ns0:complianceStatus
  a owl:ObjectProperty ;
  rdfs:label "compliance status"@en ;
  rdfs:comment "Level of compliance declared by a ComplianceDeclaration (fully compliant, partially compliant, or not compliant)."@en ;
  rdfs:domain ns0:ComplianceDeclaration ;
  rdfs:range ns0:ComplianceStatus ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:dataSetVersion
  a owl:DatatypeProperty ;
  rdfs:label "data set version"@en ;
  rdfs:comment "Version number of this LCA / EPD study instance, independent of the ontology version. Format: major.minor.sub-minor (e.g. \"02.00.011\"). Corresponds to ILCD+EPD element publicationAndOwnership/dataSetVersion."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

ns0:declaresManufacturerRecord
  a owl:ObjectProperty ;
  rdfs:label "declares manufacturer record"@en ;
  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to a ManufacturerRecord. An LCA or EPD study frequently covers a product range or sector average drawing primary data from several manufacturers; this property associates the study with each contributing manufacturer record. Distinct from the Connector property eudpp:hasManufacturer (Product -> Actor), which identifies the single manufacturer of a specific DPP-bearing product instance. Corresponds to ILCD+EPD element epd24:manufacturers/epd24:manufacturer. Domain widened in v1.9.7 from EPDStudy to LCAStudy so that any LCA study can declare its contributing manufacturers."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:ManufacturerRecord ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:en15804Group
  a owl:ObjectProperty ;
  rdfs:label "EN 15804 indicator group"@en ;
  rdfs:comment "Link from an EN15804Indicator individual to the indicator group it belongs to (core impact, with-caveats, resource use, waste, valorisation, exported energy). Object property; range is eudpp:EN15804IndicatorGroup."@en ;
  rdfs:domain ns0:EN15804Indicator ;
  rdfs:range ns0:EN15804IndicatorGroup ;
  ns0:ilcdSource "LCA ontology extension" .

ns0:epdFormatVersion
  a owl:DatatypeProperty ;
  rdfs:label "EPD format version"@en ;
  rdfs:comment "Version tag of the ILCD+EPD format used (e.g. \"1.3\"). Corresponds to ILCD+EPD attribute @epd2:epd-version on processDataSet. Renamed in v1.9.7 from v1.9.6's epdExtensionVersion (clearer wording — and parallel to eudpp:ilcdFormatVersion on LCAStudy)."@en ;
  rdfs:domain ns0:EPDStudy ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:expiryDate
  a owl:DatatypeProperty ;
  rdfs:label "expiry date"@en ;
  rdfs:comment "Date on which the EPD's validity expires. EN 15804+A2 EPDs are typically valid for five years from publication. Corresponds to ILCD+EPD element epd2:expirationDateOfEPD on time/other. Domain restricted in v1.9.7 from LCAStudy to EPDStudy: a generic LCA study does not have a regulated expiry; only EPDs do."@en ;
  rdfs:domain ns0:EPDStudy ;
  rdfs:range xsd:date ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:forLCIAOrInventoryMethod
  a owl:ObjectProperty ;
  rdfs:label "for LCIA or Inventory method"@en ;
  rdfs:comment "Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to the LCIAOrInventoryMethod used to compute it. Corresponds to ILCD+EPD element LCIAResult/referenceToLCIAMethodDataSet. Renamed in v1.9.7 from v1.9.6's forLCIAMethod to align with the renamed method class."@en ;
  rdfs:domain ns0:LCAResult ;
  rdfs:range ns0:LCIAOrInventoryMethod ;
  ns0:ilcdSource "ILCD base" .

ns0:forModule
  a owl:ObjectProperty ;
  rdfs:label "for life-cycle module"@en ;
  rdfs:comment "Link from an LCIAModuleValue to the EN 15804+A2 life-cycle module it refers to. Corresponds to ILCD+EPD attribute @epd:module on epd:amount."@en ;
  rdfs:domain ns0:LCIAModuleValue ;
  rdfs:range ns0:LifeCycleModule ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:forScenario
  a owl:DatatypeProperty ;
  rdfs:label "for scenario"@en ;
  rdfs:comment "Identifier of the scenario this LCIAModuleValue applies to (free-text label matching the EPD's scenario declaration). Corresponds to ILCD+EPD attribute @epd:scenario on epd:amount. No separate Scenario class is defined in this release; scenario descriptions, when needed, can be carried on the EPD document. A future release may introduce a Scenario class with rdfs:label for stronger validation."@en ;
  rdfs:domain ns0:LCIAModuleValue ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:hasComplianceDeclaration
  a owl:ObjectProperty ;
  rdfs:label "has compliance declaration"@en ;
  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to a ComplianceDeclaration. Compliance can be declared against any standard relevant to the study type (ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR-specific rules, etc.). Corresponds to ILCD+EPD element complianceDeclarations/compliance. Domain widened in v1.9.7 from EPDStudy to LCAStudy."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:ComplianceDeclaration ;
  ns0:ilcdSource "ILCD base" .

ns0:hasCopyright
  a owl:DatatypeProperty ;
  rdfs:label "has copyright"@en ;
  rdfs:comment "True if a copyright applies to the LCA / EPD study, false otherwise. Corresponds to ILCD+EPD element publicationAndOwnership/copyright. Modelled as xsd:boolean per the ILCD+EPD schema definition (two-valued)."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range xsd:boolean ;
  ns0:ilcdSource "ILCD base" .

ns0:hasExternalDocumentation
  a owl:ObjectProperty ;
  rdfs:label "has external documentation"@en ;
  rdfs:comment "Link from an LCAStudy to a background document (e.g. an LCA project report, safety data sheet, or explanatory material). Corresponds to ILCD+EPD element referenceToExternalDocumentation on dataSetInformation."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:Source ;
  ns0:ilcdSource "ILCD base" .

ns0:hasImpactModel
  a owl:ObjectProperty ;
  rdfs:label "has impact model"@en ;
  rdfs:comment "Link from an LCIAOrInventoryMethod to its characterisation-model block (where applicable; inventory-only methods may not have one). Corresponds to ILCD+EPD element impactModel on LCIAMethodDataSet."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:ImpactModel ;
  ns0:ilcdSource "ILCD base" .

ns0:hasInventoryIndicatorResult
  a owl:ObjectProperty ;
  rdfs:label "has inventory indicator result"@en ;
  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to one of its aggregated inventory-indicator results. Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:InventoryIndicatorResult. Corresponds to ILCD+EPD element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 inventory indicator (resource use, waste, output flows). Renamed in v1.9.7 from v1.9.6's hasInventoryResult (the previous name was ambiguous with raw life-cycle inventory; this property addresses aggregated indicator-level inventory results)."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:InventoryIndicatorResult ;
  rdfs:subPropertyOf ns0:hasLCAResult ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:hasLCIAResult
  a owl:ObjectProperty ;
  rdfs:label "has LCIA result"@en ;
  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to one of its characterised impact results. Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:LCIAResult. Corresponds to ILCD+EPD element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 impact indicator."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:LCIAResult ;
  rdfs:subPropertyOf ns0:hasLCAResult ;
  ns0:ilcdSource "ILCD base" .

ns0:hasModuleValue
  a owl:ObjectProperty ;
  rdfs:label "has module value"@en ;
  rdfs:comment "Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to one of its per-module (and optionally per-scenario) numerical values. Corresponds to ILCD+EPD element LCIAResult/other/epd:amount."@en ;
  rdfs:domain ns0:LCAResult ;
  rdfs:range ns0:LCIAModuleValue ;
  ns0:ilcdSource "ILCD+EPD extension" .

ns0:hasReview
  a owl:ObjectProperty ;
  rdfs:label "has review"@en ;
  rdfs:comment "Link from an LCAStudy to a critical-review / verification record. Corresponds to ILCD+EPD element validation/review."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range ns0:Review ;
  ns0:ilcdSource "ILCD base" .

ns0:hasUnit
  a owl:ObjectProperty ;
  rdfs:label "has unit"@en ;
  rdfs:comment "Link from an LCIAModuleValue (or LCIAOrInventoryMethod) to the unit (OM-2 Unit individual) in which the value is expressed. Corresponds to ILCD+EPD element referenceToUnitGroupDataSet. Range is the externally-defined om-2:Unit class. Replaces v1.9.4's xsd:string-typed eudpp:hasUnit."@en ;
  rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ;
  ns0:ilcdSource "ILCD base" .

ns0:ilcdFormatVersion
  a owl:DatatypeProperty ;
  rdfs:label "ILCD format version"@en ;
  rdfs:comment "ILCD schema version used by the source serialisation of this study (e.g. '1.1'). Corresponds to ILCD+EPD attribute @version on processDataSet."@en ;
  rdfs:domain ns0:LCAStudy ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

ns0:ilcdSource
  a owl:AnnotationProperty ;
  rdfs:label "ILCD source"@en ;
  rdfs:comment "Provenance annotation identifying whether a class, property or named individual of this ontology originates from the ILCD base data format (\"ILCD base\"), from the ILCD+EPD v1.3 extension i.e. the epd / epd2 / epd24 namespaces of InData (\"ILCD+EPD extension\"), is introduced by this LCA module without direct ILCD counterpart (\"LCA ontology extension\"), or is internal annotation metadata of this module (\"LCA ontology metadata\"). Annotation property; does not affect reasoning."@en ;
  ns0:ilcdSource "LCA ontology metadata" .

ns0:impactCategory
  a owl:ObjectProperty ;
  rdfs:label "impact category"@en ;
  rdfs:comment "Impact category addressed by the LCIAOrInventoryMethod. Corresponds to ILCD+EPD element impactCategory on LCIAMethodDataSet."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range ns0:LCIAImpactCategory ;
  ns0:ilcdSource "ILCD base" .

ns0:impactIndicatorDescription
  a owl:DatatypeProperty ;
  rdfs:label "impact indicator description"@en ;
  rdfs:comment "Human-readable description of the indicator's meaning (what it measures, how to interpret). Corresponds to ILCD+EPD element impactIndicator on LCIAMethodDataSet."@en ;
  rdfs:domain ns0:LCIAOrInventoryMethod ;
  rdfs:range xsd:string ;
  ns0:ilcdSource "ILCD base" .

ns0:ind_ADPE
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;
  rdfs:label "ADPE - Abiotic Depletion Potential (elements, minerals and metals)"@en ;
  rdfs:comment "Abiotic depletion potential for non-fossil resources (minerals and metals), in kg Sb-equivalent. Core EN 15804+A2 impact indicator."@en ;
  skos:altLabel "ADPE"@en ;
  ns0:en15804Group ns0:group_coreImpact ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "kg Sb-eq"@en .

ns0:ind_ADPF
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;
  rdfs:label "ADPF - Abiotic Depletion Potential (fossil resources)"@en ;
  rdfs:comment "Abiotic depletion potential for fossil resources, in MJ (net calorific value). Core EN 15804+A2 impact indicator."@en ;
  skos:altLabel "ADPF"@en ;
  ns0:en15804Group ns0:group_coreImpact ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "MJ, net calorific value"@en .

ns0:ind_AP
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;
  rdfs:label "AP - Acidification (accumulated exceedance)"@en ;
  rdfs:comment "Acidification accumulated exceedance, in mol H+-equivalent. Core EN 15804+A2 impact indicator (note: unit change versus EN 15804+A1, which used kg SO2-eq)."@en ;
  skos:altLabel "AP"@en ;
  ns0:en15804Group ns0:group_coreImpact ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "mol H+-eq"@en .

ns0:ind_CRU
  a owl:NamedIndividual, ns0:EN15804InventoryIndicator ;
  rdfs:label "CRU - Components for re-use"@en ;
  rdfs:comment "Components for re-use, in kg. EN 15804+A2 inventory indicator (output flow - valorisation)."@en ;
  skos:altLabel "CRU"@en ;
  ns0:en15804Group ns0:group_valorisation ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "kg"@en .

ns0:ind_EEE
  a owl:NamedIndividual, ns0:EN15804InventoryIndicator ;
  rdfs:label "EEE - Exported electrical energy"@en ;
  rdfs:comment "Exported electrical energy, in MJ per energy carrier. EN 15804+A2 inventory indicator (output flow - exported energy)."@en ;
  skos:altLabel "EEE"@en ;
  ns0:en15804Group ns0:group_exportedEnergy ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "MJ per energy carrier"@en .

ns0:ind_EET
  a owl:NamedIndividual, ns0:EN15804InventoryIndicator ;
  rdfs:label "EET - Exported thermal energy"@en ;
  rdfs:comment "Exported thermal energy, in MJ per energy carrier. EN 15804+A2 inventory indicator (output flow - exported energy)."@en ;
  skos:altLabel "EET"@en ;
  ns0:en15804Group ns0:group_exportedEnergy ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "MJ per energy carrier"@en .

ns0:ind_EF_acidification
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Acidification"@en ;
  rdfs:comment "Accumulated exceedance, in mol H+-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Acidification"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "mol H+-eq"@en .

ns0:ind_EF_climateChange
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Climate change"@en ;
  rdfs:comment "Radiative forcing as global warming potential, GWP100, expressed in kg CO2-equivalent. Aggregate of climate-change effects from fossil, biogenic and land-use-and-land-use-change sources. EF 3.1 / PEF impact category. Colloquially known as the carbon footprint of the product. JRC characterisation factors per EUR 31414 EN (2023)."@en ;
  skos:altLabel "Carbon footprint"@en, "Climate change"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg CO2-eq"@en .

ns0:ind_EF_ecotoxicityFreshwater
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Ecotoxicity, freshwater"@en ;
  rdfs:comment "Comparative toxic unit for ecosystems (freshwater), in CTUe. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Ecotoxicity, freshwater"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "CTUe"@en .

ns0:ind_EF_eutrophicationFreshwater
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Eutrophication, freshwater"@en ;
  rdfs:comment "Fraction of nutrients reaching the freshwater end compartment, in kg P-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Eutrophication, freshwater"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg P-eq"@en .

ns0:ind_EF_eutrophicationMarine
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Eutrophication, marine"@en ;
  rdfs:comment "Fraction of nutrients reaching the marine end compartment, in kg N-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Eutrophication, marine"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg N-eq"@en .

ns0:ind_EF_eutrophicationTerrestrial
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Eutrophication, terrestrial"@en ;
  rdfs:comment "Accumulated exceedance for terrestrial compartments, in mol N-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Eutrophication, terrestrial"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "mol N-eq"@en .

ns0:ind_EF_humanToxicityCancer
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Human toxicity, cancer"@en ;
  rdfs:comment "Human toxicity, cancer effects, in CTUh (comparative toxic unit for humans). EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Human toxicity, cancer"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "CTUh"@en .

ns0:ind_EF_humanToxicityNonCancer
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Human toxicity, non-cancer"@en ;
  rdfs:comment "Human toxicity, non-cancer effects, in CTUh. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Human toxicity, non-cancer"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "CTUh"@en .

ns0:ind_EF_ionisingRadiationHumanHealth
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Ionising radiation, human health"@en ;
  rdfs:comment "Human exposure efficiency to ionising radiation, relative to U-235, in kBq U235-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Ionising radiation, human health"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kBq U235-eq"@en .

ns0:ind_EF_landUse
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Land use"@en ;
  rdfs:comment "Soil quality index, dimensionless (Pt), aggregating biotic production, erosion resistance, mechanical filtration and groundwater replenishment. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Land use"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "dimensionless (Pt)"@en .

ns0:ind_EF_ozoneDepletion
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Ozone depletion"@en ;
  rdfs:comment "Ozone depletion potential (ODP), in kg CFC-11-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Ozone depletion"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg CFC-11-eq"@en .

ns0:ind_EF_particulateMatter
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Particulate matter"@en ;
  rdfs:comment "Impact on human health from fine particulate matter, in disease incidence. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Particulate matter"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "disease incidence"@en .

ns0:ind_EF_photochemicalOzoneFormation
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Photochemical ozone formation, human health"@en ;
  rdfs:comment "Tropospheric ozone concentration increase, photochemical ozone formation potential, in kg NMVOC-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Photochemical ozone formation, human health"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg NMVOC-eq"@en .

ns0:ind_EF_resourceUseFossils
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Resource use, fossils"@en ;
  rdfs:comment "Abiotic resource depletion of fossil fuels (ADP-fossil), in MJ. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Resource use, fossils"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "MJ"@en .

ns0:ind_EF_resourceUseMineralsMetals
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Resource use, minerals and metals"@en ;
  rdfs:comment "Abiotic resource depletion (ADP) of mineral and metal resources, in kg Sb-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Resource use, minerals and metals"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "kg Sb-eq"@en .

ns0:ind_EF_singleScore
  a owl:NamedIndividual, ns0:EnvironmentalFootprintScore ;
  rdfs:label "Environmental Footprint single score"@en ;
  rdfs:comment "EU Environmental Footprint single score (also referred to as PEF score), computed as a normalised and weighted aggregate of the 16 EF impact-category results. Expressed in dimensionless points (Pt). The applied normalisation factors and weighting set are determined by the methodology version (e.g. EF 3.1 per JRC EUR 31414 EN), which is resolvable from the study via eudpp:hasComplianceDeclaration on its referenced eudpp:ComplianceSystem source."@en ;
  skos:altLabel "EF single score"@en, "Environmental footprint"@en, "PEF score"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "dimensionless (Pt)"@en .

ns0:ind_EF_waterUse
  a owl:NamedIndividual, ns0:LCIAImpactIndicator ;
  rdfs:label "Water use"@en ;
  rdfs:comment "Weighted user deprivation potential, in m3 world-equivalent. EF 3.1 / PEF impact category."@en ;
  skos:altLabel "Water use"@en ;
  ns0:ilcdSource "LCA ontology extension" ;
  ns0:unitAsString "m3 world-eq"@en .

ns0:ind_EPfreshwater
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;
  rdfs:label "EP-freshwater - Eutrophication (freshwater)"@en ;
  rdfs:comment "Fraction of nutrients reaching freshwater end compartment, in kg P-equivalent. Core EN 15804+A2 impact indicator. ERRATUM: the published text of EN 15804:2012+A2:2019 states the unit as 'kg PO4-eq' for this indicator, but the characterisation factors used by the EF 3.1 implementation operate on phosphorus (P), so the correct unit when reporting results against EF 3.1 characterisation factors is 'kg P-eq'. This ontology adopts the corrected unit. See JRC / EPD programme clarifications for details."@en ;
  skos:altLabel "EP-freshwater"@en ;
  ns0:en15804Group ns0:group_coreImpact ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "kg P-eq"@en .

ns0:ind_EPmarine
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;
  rdfs:label "EP-marine - Eutrophication (marine)"@en ;
  rdfs:comment "Fraction of nutrients reaching marine end compartment, in kg N-equivalent. Core EN 15804+A2 impact indicator."@en ;
  skos:altLabel "EP-marine"@en ;
  ns0:en15804Group ns0:group_coreImpact ;
  ns0:ilcdSource "ILCD+EPD extension" ;
  ns0:unitAsString "kg N-eq"@en .

ns0:ind_EPterrestrial
  a owl:NamedIndividual, ns0:EN15804ImpactIndicator ;

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns0: <http://purl.org/vocab/vann#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/eudpp/CONNECTOR>
  a owl:Ontology ;
  dcterms:created "2025-02-27"@en ;
  dcterms:creator "Riina Maigre"@en, "Tarmo Robal"@en ;
  dcterms:description """Connector (Bridge) module that only defines object properties between modules. The connector contains only object properties that have domain and range specified in different modules. 

--
THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. 
All liability for any damages arising from use or misuse of this vocabulary is with the user."""@en ;
  dcterms:issued "2026-07-06"@en ;
  dcterms:licence <https://www.apache.org/licenses/LICENSE-2.0>, """This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."""@en ;
  dcterms:title "The Connector module of the EU regulatory compliant Digital Product Passport Core Ontology (EU DPP CO) proposed by the CIRPASS-2 European project."@en ;
  ns0:preferredNamespacePrefix "con" ;
  rdfs:comment "The CONNECTOR module of the EU DPP core ontology proposal of the CIRPASS-2 European project."@en ;
  rdfs:label "EU DPP CORE CONNECTOR"@en ;
  owl:versionInfo "2.0" .

dcterms:contributor a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:identifier a owl:AnnotationProperty .
dcterms:issued a owl:AnnotationProperty .
dcterms:licence a owl:AnnotationProperty .
dcterms:references a owl:AnnotationProperty .
dcterms:source a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .
ns0:preferredNamespacePrefix a owl:AnnotationProperty .
<https://w3id.org/eudpp#isMandatory> a owl:AnnotationProperty .
xsd:date a rdfs:Datatype .

<https://w3id.org/eudpp#concernsDPP>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
  rdfs:range <https://w3id.org/eudpp#DPP> ;
  rdfs:comment """Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This property captures information-level changes and is not intended to represent physical or operational events on the product.

DPP is modelled in the EU DPP CO P_DPP module.
DPPEvent is modelled in the EU DPP CO EVENT module."""@en ;
  rdfs:label "Concerns DPP"@en .

<https://w3id.org/eudpp#concernsProduct>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
  rdfs:range <https://w3id.org/eudpp#Product> ;
  rdfs:comment """Links a product event to the product whose state, condition, or lifecycle is affected by the event.

Product is modelled in the EU DPP CO P_DPP module.
ProductEvent is modelled in the EU DPP CO EVENT module."""@en ;
  rdfs:label "Concerns product"@en .

<https://w3id.org/eudpp#conformityAttestedBy>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "ESPR Annex V (7)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies the notified body that attest the product's conformity with Union harmonisation legislation. 

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Conformity attested by"@en .

<https://w3id.org/eudpp#containsSubstanceOfConcern>
  a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
     <https://w3id.org/eudpp#MaterialOfComposition>
     <https://w3id.org/eudpp#Product>
   )
  ] ;
  rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
  rdfs:comment """Linking the product to a substance of concern the product contains.

Product is modelled in the EU DPP CO P_DPP module.
Substance of concern is modelled in the EU DPP CO SOC module."""@en ;
  rdfs:label "Contains substance of concern"@en .

<https://w3id.org/eudpp#hasAuthorisedRepresentative>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "Decision No 768/2008/EC Annex I Art R1 (4)", "ESPR Annex V (2,9)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.

Source: 
Decision No 768/2008/EC Annex I Art R1 (4)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I

ESPR Annex V (2,9)
https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V"""@en ;
  rdfs:label "Has authorised representative"@en .

<https://w3id.org/eudpp#hasBackUpCopyHost>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPP> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "ESPR Annex III" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
  rdfs:comment """The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has back-up-copy host"@en .

<https://w3id.org/eudpp#hasDigitalProductPassportId>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPP> ;
  rdfs:range <https://w3id.org/eudpp#DPPIdentifier> ;
  rdfs:comment """Realisation for the Unique identifier of an instance of the digital product passport.

DPP is modelled in the EU DPP CO P_DPP module.
DPPIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
  rdfs:label "Has digital product passport id"@en .

<https://w3id.org/eudpp#hasEUDeclarationOfConformity>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:range <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  dcterms:references "Decision No 768/2008/EC Annex I Art R10", "ESPR Art 44" ;
  dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44" ;
  rdfs:comment """Specifies the EU declaration of conformity issued for the product.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
  rdfs:label "Has EU Declaration of Conformity"@en .

<https://w3id.org/eudpp#hasEconomicOperator>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  rdfs:comment """Linking the product to the economic operator (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has economic operator"@en .

<https://w3id.org/eudpp#hasIssuer>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPP> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  rdfs:comment """Linking DPP with its issuer (Actor from ACTOR module).

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has issuer"@en .

# OFFEN: rdfs:range fehlt in der Quelle. Kommentar nennt LcaResult (LCA-Modul),
# die Klasse ist aber nicht als URI angegeben. Nicht ergaenzt, da nicht belegbar.
<https://w3id.org/eudpp#hasLCAStudy>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:comment """A product has a LCA Result -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.

Product is modelled in the EU DPP CO P_DPP module.
LcaResult is modelled in the EU DPP CO LCA module."""@en ;
  rdfs:label "Has LCA study"@en .

<https://w3id.org/eudpp#hasManufacturer>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  rdfs:comment """A product has a manufacturer (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has manufacturer"@en .

<https://w3id.org/eudpp#hasMaterial>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:range <https://w3id.org/eudpp#MaterialOfComposition> ;
  rdfs:comment """Linking the Product to a MaterialOfComposition.

Product is modelled in the EU DPP CO P_DPP module.
MaterialOfComposition is modelled in the EU DPP CO MAT module."""@en ;
  rdfs:label "Has material"@en .

<https://w3id.org/eudpp#hasMaterialIdentifier>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
  rdfs:range <https://w3id.org/eudpp#MaterialIdentifier> ;
  rdfs:comment """Realisation of the material identifier as "Product parameters: identification of  ... materials [ESPR Annex I c)]"

MaterialOfComposition is modelled in the EU DPP CO MAT module.
MaterialIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
  rdfs:label "Has material identifier"@en .

<https://w3id.org/eudpp#hasNotifiedBody>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "Decision No 768/2008/EC Annex I Chapter R4", "ESPR Chapter IX" ;
  dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX" ;
  rdfs:comment """Specifies the conformity assessment body notified in accordance with ESPR Chapter IX

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has notified body"@en .

<https://w3id.org/eudpp#hasResponsibleManufacturer>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "Decision No 768/2008/EC Annex I Art R1 (3)", "ESPR Annex V (2,9)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Has responsible manufacturer"@en .

<https://w3id.org/eudpp#hasUniqueFacilityIdentifier>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Facility> ;
  rdfs:range <https://w3id.org/eudpp#FacilityIdentifier> ;
  dcterms:references "ESPR Art 2 (33)"@en ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
  rdfs:comment """Linking a Facility to its unique facility identifier.
Facility is modelled in the EU DPP CO ACTOR module.
FacilityIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
  rdfs:label "Has unique facility identifier"@en .

<https://w3id.org/eudpp#hasUniqueOperatorIdentifier>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Actor> ;
  rdfs:range <https://w3id.org/eudpp#ActorIdentifier> ;
  dcterms:references "ESPR Art 2 (31)"@en ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
  rdfs:comment """Linking an Actor to their unique operator identifier. 
Actor is modelled in the EU DPP CO ACTOR module.
ActorIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
  rdfs:label "Has unique operator identifier"@en .

<https://w3id.org/eudpp#hasUniqueProductIdentifier>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:range <https://w3id.org/eudpp#ProductIdentifier> ;
  rdfs:comment """Realisation of the uniqueProductIdentifier.

Product is modelled in the EU DPP CO P_DPP module.
ProductIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
  rdfs:label "Has unique product identifier"@en .

<https://w3id.org/eudpp#inContextOfActivity>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
  rdfs:range <https://w3id.org/eudpp#Event> ;
  rdfs:comment """Relates the actor role assignment to a specific lifecycle activity, such as a repair or recycling event (from the Event module).
        
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Event is modelled in the EU DPP CO EVENT module.
        """@en ;
  rdfs:label "In context of activity"@en .

<https://w3id.org/eudpp#inContextOfDPP>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
  rdfs:range <https://w3id.org/eudpp#DPP> ;
  rdfs:comment """Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
DPP is modelled in the EU DPP CO P_DPP module.
        """@en ;
  rdfs:label "In context of DPP"@en .

<https://w3id.org/eudpp#inContextOfProduct>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
  rdfs:range <https://w3id.org/eudpp#Product> ;
  rdfs:comment """Relates the actor role assignment to a specific product (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
  rdfs:label "In context of product"@en .

# OFFEN: rdfs:range fehlt in der Quelle. Kommentar nennt Union Harmonisation
# Legislation; die Klasse existiert als eudpp#UnionHarmonisationLegislation,
# ist hier aber nicht als range gesetzt. Nicht ergaenzt, da nicht belegbar.
<https://w3id.org/eudpp#isConformWith>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Product> ;
  rdfs:comment "Specifies Union Harmonised Legislation for which conformity of the product is stated."@en ;
  rdfs:label "Is conform with"@en .

<https://w3id.org/eudpp#isConnectedTo>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPP> ;
  rdfs:range <https://w3id.org/eudpp#Facility> ;
  rdfs:comment """A DPP is connected to a facility.

DPP is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Is connected to"@en .

<https://w3id.org/eudpp#isIssuedBy>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "ESPR Annex V (3)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: "This declaration of conformity is issued under the sole responsibility of the manufacturer:"


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Issued by"@en .

<https://w3id.org/eudpp#isNotifiedFor>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Actor> ;
  rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
  dcterms:references "Decision No 768/2008/EC Annex I Art R23 (3)", "ESPR Article 56 (3)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_56" ;
  rdfs:comment """Specifies the conformity assessment activities, the conformity assessment module or modules and product or products concerned and the relevant attestation of competence

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Is notified for"@en .

<https://w3id.org/eudpp#isSignedBy>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  dcterms:references "ESPR Annex V (9, 10)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies the natural or legal person signing the Declaration of Conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Is signed by"@en .

<https://w3id.org/eudpp#issuesCertificate>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Actor> ;
  rdfs:range <https://w3id.org/eudpp#ConformityCertificate> ;
  dcterms:references "ESPR Annex V (7)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies conformity assessment certificate issued for a certification.


ConformityCertificate is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Issues certificate"@en .

<https://w3id.org/eudpp#performedAssessmentAccordingTo>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#Actor> ;
  rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
  dcterms:references "ESPR Annex V (7)" ;
  dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
  rdfs:comment """Specifies conformity assessment procedure/certification scheme performed by the notified body.


ConformityAssessmentModule is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Performed assessment according to"@en .

<https://w3id.org/eudpp#recordedBy>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
  rdfs:range <https://w3id.org/eudpp#Actor> ;
  rdfs:comment """Links a DPP event record to the actor that created the technical record of the logged DPP-side event.

DPPEventRecord is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
  rdfs:label "Recorded by"@en .

<https://w3id.org/eudpp#representsManufacturerForProduct>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
  rdfs:range <https://w3id.org/eudpp#Product> ;
  rdfs:comment """Indicates which product(s) the authorised representative's mandate covers.

AuthorisedRepresentativeRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
  rdfs:label "Represents manufacturer for product"@en .

<https://w3id.org/eudpp#Actor>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR> .

<https://w3id.org/eudpp#ActorIdentifier>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT> .

<https://w3id.org/eudpp#ActorRoleAssignment>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR> .

<https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR> .

<https://w3id.org/eudpp#ConformityAssessmentModule>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/COMP> .

<https://w3id.org/eudpp#ConformityCertificate>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/COMP> .

<https://w3id.org/eudpp#DPP>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP> .

<https://w3id.org/eudpp#DPPEvent>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/EVENT> .

<https://w3id.org/eudpp#DPPEventRecord>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/EVENT> .

<https://w3id.org/eudpp#DPPIdentifier>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT> .

<https://w3id.org/eudpp#DocumentFormattedProperty>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP> .

<https://w3id.org/eudpp#EUDeclarationOfConformity>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/eudpp#DocumentFormattedProperty> ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/COMP> .

<https://w3id.org/eudpp#Event>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/EVENT> .

<https://w3id.org/eudpp#Facility>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR> .

<https://w3id.org/eudpp#FacilityIdentifier>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT> .

<https://w3id.org/eudpp#MaterialIdentifier>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT> .

<https://w3id.org/eudpp#MaterialOfComposition>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/MAT> .

<https://w3id.org/eudpp#Product>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP> .

<https://w3id.org/eudpp#ProductEvent>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/EVENT> .

<https://w3id.org/eudpp#ProductIdentifier>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT> .

<https://w3id.org/eudpp#SubstanceOfConcern>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> .

<https://w3id.org/eudpp#UnionHarmonisationLegislation>
  a owl:Class ;
  rdfs:isDefinedBy <https://w3id.org/eudpp/COMP> .

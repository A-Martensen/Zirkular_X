# baseURI: https://zirkular-x/zxo
# prefix: zxo

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zxo: <https://zirkular-x/zxo#> .

<https://zirkular-x/zxo>
  rdf:type owl:Ontology ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
zxo:AveTimeInUse
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_LCInfo ;
.
zxo:BuildingType
  rdf:type owl:Class ;
  rdfs:label "Building type"@en ;
  rdfs:label "Gebaeudetyp"@de ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          zxo:ResidentialBuilding
          zxo:OfficeAndAdministrationBuilding
          zxo:ResearchAndEducationBuilding
          zxo:HealthcareBuilding
          zxo:CulturalBuilding
          zxo:SportsAndRecreationBuilding
          zxo:ProductionAndStorageBuilding
          zxo:TradeAndCommerceBuilding
        ) ;
    ] ;
.
zxo:CulturalBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Cultural building"@en ;
  rdfs:label "Kulturbau"@de ;
.
zxo:HealthcareBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Gebaeude des Gesundheitswesens"@de ;
  rdfs:label "Healthcare building"@en ;
.
zxo:Height
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:QuantitativeDesc ;
.
zxo:InstructedPerson
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:UserGroup ;
  rdfs:comment "Person who has received instruction."@en ;
  rdfs:label "Instructed person"@en ;
  rdfs:label "Unterwiesene Person"@de ;
.
zxo:LCKeyDates
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_LCInfo ;
.
zxo:LastDisassemblyDate
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:LCKeyDates ;
.
zxo:Length
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:QuantitativeDesc ;
.
zxo:MaintenanceDate
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:LCKeyDates ;
.
zxo:MinTimeInUse
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_LCInfo ;
.
zxo:OfficeAndAdministrationBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Buero- und Verwaltungsgebaeude"@de ;
  rdfs:label "Office and administration building"@en ;
.
zxo:OperatingContitions
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:OperationalDesc ;
.
zxo:OperatingPersonnel
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:UserGroup ;
  rdfs:comment "Layperson or user."@en ;
  rdfs:label "Bedienpersonal"@de ;
  rdfs:label "Operating personnel"@en ;
.
zxo:OperationalDesc
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_Desciption ;
.
zxo:P_DPP
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:P_Desciption
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:P_Identificator
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:P_LCInfo
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:P_MEP
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:ProductionAndStorageBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Gebaeude fuer Produktion und Lagerung"@de ;
  rdfs:label "Production and storage building"@en ;
.
zxo:ProductionDate
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:LCKeyDates ;
.
zxo:QualifiedSpecialist
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:UserGroup ;
  rdfs:comment "Skilled worker with specific training and professional experience."@en ;
  rdfs:label "Qualified specialist"@en ;
  rdfs:label "Qualifiziertes Fachpersonal"@de ;
.
zxo:QuantitativeDesc
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_Desciption ;
.
zxo:ResearchAndEducationBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Forschungs- und Lehrgebaeude"@de ;
  rdfs:label "Research and education building"@en ;
.
zxo:ResidentialBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Residential building"@en ;
  rdfs:label "Wohngebaeude"@de ;
.
zxo:SportsAndRecreationBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Gebaeude fuer Sport und Erholung"@de ;
  rdfs:label "Sports and recreation building"@en ;
.
zxo:TechnicalDesc
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:P_Desciption ;
.
zxo:TradeAndCommerceBuilding
  rdf:type owl:NamedIndividual ;
  rdf:type zxo:BuildingType ;
  rdfs:label "Gebaeude fuer Handel und Gewerbe"@de ;
  rdfs:label "Trade and commerce building"@en ;
.
zxo:Unit
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
zxo:UserGroup
  rdf:type owl:Class ;
  rdfs:label "Nutzergruppe"@de ;
  rdfs:label "User group"@en ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          zxo:OperatingPersonnel
          zxo:InstructedPerson
          zxo:QualifiedSpecialist
        ) ;
    ] ;
.
zxo:Weight
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:QuantitativeDesc ;
.
zxo:Width
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:QuantitativeDesc ;
.
zxo:hasBuildingType
  rdf:type owl:ObjectProperty ;
  rdfs:label "has building type"@en ;
  rdfs:label "hat Gebaeudetyp"@de ;
  rdfs:range zxo:BuildingType ;
.
zxo:requiresUserGroup
  rdf:type owl:FunctionalProperty ;
  rdf:type owl:ObjectProperty ;
  rdfs:label "requires user group"@en ;
  rdfs:range zxo:UserGroup ;
.
[
  rdf:type owl:AllDifferent ;
  owl:distinctMembers (
      zxo:OperatingPersonnel
      zxo:InstructedPerson
      zxo:QualifiedSpecialist
    ) ;
].

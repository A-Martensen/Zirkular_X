org.topbraidcomposer.sparql.view.editor.QueryEditor.query=PREFIX rdfs\: <http\://www.w3.org/2000/01/rdf-schema\#>\r\nPREFIX zxo\:  <https\://your-ns/zxo\#>\r\n\r\nSELECT ?direction ?property ?other\r\nWHERE {\r\n  { ?property rdfs\:range zxo\:BuildingProduct ; rdfs\:domain ?other .\r\n    BIND("incoming" AS ?direction) }\r\n  UNION\r\n  { ?property rdfs\:domain zxo\:BuildingProduct ; rdfs\:range ?other .\r\n    BIND("outgoing" AS ?direction) }\r\n}\r\nORDER BY ?direction ?property\r\n\r\n\r\n\r\n\r\n

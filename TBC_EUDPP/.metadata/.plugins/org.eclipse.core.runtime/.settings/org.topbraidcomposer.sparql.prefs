eclipse.preferences.version=1
org.topbraidcomposer.sparql.view.editor.QueryEditor.query=PREFIX rdfs\: <http\://www.w3.org/2000/01/rdf-schema\#>\r\nPREFIX owl\:  <http\://www.w3.org/2002/07/owl\#>\r\n\r\nSELECT DISTINCT ?term ?typ ?domain ?range\r\nWHERE {\r\n  ?term a ?typ .\r\n  VALUES ?typ { owl\:Class owl\:ObjectProperty owl\:DatatypeProperty }\r\n  OPTIONAL { ?term rdfs\:domain ?domain }\r\n  OPTIONAL { ?term rdfs\:range  ?range }\r\n  FILTER (REGEX(STR(?term),\r\n    "carrier|granular|scheme|issu|source|provenance|confidence|method|timestamp|version|unit|requirement|conform|diligence|dismantl|disassembl|interval|staff|personnel|repair|event|date",\r\n    "i"))\r\n}\r\nORDER BY ?term

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zx: <https://w3id.org/zirkular-x#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:versionIRI a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

zx:CircularityIndicator a owl:Class ;
    rdfs:label "Circularity Indicator" ;
    rdfs:subClassOf zx:ProductProperty .

zx:CompDesc a owl:Class ;
    rdfs:label "Comp Desc" ;
    rdfs:subClassOf zx:ProductDoc .

zx:Disassembly a owl:Class ;
    rdfs:label "Disassembly" ;
    rdfs:subClassOf zx:LifecycleEvent .

zx:EOLRecs a owl:Class ;
    rdfs:label "E O L Recs" ;
    rdfs:subClassOf zx:ProductDoc .

zx:HVACProduct a owl:Class ;
    rdfs:label "H V A C Product" ;
    rdfs:subClassOf zx:BuildingProduct .

zx:ImpactIndicator a owl:Class ;
    rdfs:label "Impact Indicator" ;
    rdfs:subClassOf zx:ProductProperty .

zx:InstallationInst a owl:Class ;
    rdfs:label "Installation Inst" ;
    rdfs:subClassOf zx:ProductDoc .

zx:Maintenance a owl:Class ;
    rdfs:label "Maintenance" ;
    rdfs:subClassOf zx:LifecycleEvent .

zx:SafetyInst a owl:Class ;
    rdfs:label "Safety Inst" ;
    rdfs:subClassOf zx:ProductDoc .

zx:UsageInst a owl:Class ;
    rdfs:label "Usage Inst" ;
    rdfs:subClassOf zx:ProductDoc .

zx: a owl:Ontology ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:creator <https://w3id.org/TODO-author-URI> ;
    dcterms:description "TODO"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "ZIRKULAR-X Ontology"@en ;
    vann:preferredNamespacePrefix "zx" ;
    vann:preferredNamespaceUri zx: ;
    owl:versionIRI <https://w3id.org/zirkular-x/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

zx:consistsOf a owl:ObjectProperty ;
    rdfs:label "consists of" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:BuildingProduct .

zx:consistsOfMaterial a owl:ObjectProperty ;
    rdfs:label "consists of material" ;
    rdfs:domain zx:MaterialComposition ;
    rdfs:range zx:Material .

zx:hasBuildingType a owl:ObjectProperty ;
    rdfs:label "has building type" ;
    rdfs:domain zx:Building ;
    rdfs:range zx:BuildingType .

zx:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier" ;
    rdfs:domain zx:DPP ;
    rdfs:range zx:UniqueIdentifier .

zx:hasInstructionDoc a owl:ObjectProperty ;
    rdfs:label "has instruction doc" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:ProductDoc .

zx:hasLifecycleEvent a owl:ObjectProperty ;
    rdfs:label "has lifecycle event" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:LifecycleEvent .

zx:hasManufacturer a owl:ObjectProperty ;
    rdfs:label "has manufacturer" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:Manufacturer .

zx:hasMaterialComposition a owl:ObjectProperty ;
    rdfs:label "has material composition" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:MaterialComposition .

zx:hasProductProperty a owl:ObjectProperty ;
    rdfs:label "has product property" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:ProductProperty .

zx:hasProductionLocation a owl:DatatypeProperty ;
    rdfs:label "has production location" ;
    rdfs:domain zx:StartOfLife ;
    rdfs:range xsd:string .

zx:hasRelatedDPP a owl:ObjectProperty ;
    rdfs:label "has related d p p" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:DPP .

zx:hasRelatedProduct a owl:ObjectProperty ;
    rdfs:label "has related product" ;
    rdfs:domain zx:DPP ;
    rdfs:range zx:BuildingProduct .

zx:hasTimeDate a owl:DatatypeProperty ;
    rdfs:label "has time date" ;
    rdfs:domain zx:LifecycleEvent ;
    rdfs:range xsd:dateTime .

zx:isLocatedInBuilding a owl:ObjectProperty ;
    rdfs:label "is located in building" ;
    rdfs:domain zx:BuildingProduct ;
    rdfs:range zx:Building .

zx:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:domain zx:StartOfLife ;
    rdfs:range zx:Manufacturer .

zx:BuildingType a owl:Class ;
    rdfs:label "Building Type" .

zx:Material a owl:Class ;
    rdfs:label "Material" .

zx:StartOfLife a owl:Class ;
    rdfs:label "Start Of Life" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom zx:Manufacturer ;
            owl:onProperty zx:performedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty zx:hasProductionLocation ],
        zx:LifecycleEvent .

zx:UniqueIdentifier a owl:Class ;
    rdfs:label "Unique Identifier" .

zx:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom zx:BuildingType ;
            owl:onProperty zx:hasBuildingType ] .

zx:MaterialComposition a owl:Class ;
    rdfs:label "Material Composition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom zx:Material ;
            owl:onProperty zx:consistsOfMaterial ] .

zx:DPP a owl:Class ;
    rdfs:label "D P P" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom zx:BuildingProduct ;
            owl:onProperty zx:hasRelatedProduct ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:UniqueIdentifier ;
            owl:onProperty zx:hasIdentifier ] .

zx:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer" .

zx:ProductProperty a owl:Class ;
    rdfs:label "Product Property" .

zx:LifecycleEvent a owl:Class ;
    rdfs:label "Lifecycle Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty zx:hasTimeDate ] .

zx:ProductDoc a owl:Class ;
    rdfs:label "Product Doc" .

zx:BuildingProduct a owl:Class ;
    rdfs:label "Building Product" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom zx:ProductDoc ;
            owl:onProperty zx:hasInstructionDoc ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:ProductProperty ;
            owl:onProperty zx:hasProductProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:MaterialComposition ;
            owl:onProperty zx:hasMaterialComposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:LifecycleEvent ;
            owl:onProperty zx:hasLifecycleEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:Manufacturer ;
            owl:onProperty zx:hasManufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:Building ;
            owl:onProperty zx:isLocatedInBuilding ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:BuildingProduct ;
            owl:onProperty zx:consistsOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom zx:DPP ;
            owl:onProperty zx:hasRelatedDPP ] .


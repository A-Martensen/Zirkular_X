zxo:hasMaterialName
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:BuildingProductMaterialShare ;
  rdfs:label "has material name"@en ;
  rdfs:label "hat Materialname"@de ;
  rdfs:range xsd:string ;
.
zxo:hasMaterialShare
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProductMaterialComposition ;
  rdfs:range zxo:BuildingProductMaterialShare ;
.
zxo:hasMatrialComposition
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;
  rdfs:range zxo:BuildingProductDesc ;
.
zxo:hasNumercalValue
  rdf:type rdf:Property ;

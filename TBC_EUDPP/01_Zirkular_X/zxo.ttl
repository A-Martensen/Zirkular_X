  rdfs:label "hat Hausnummer"@de ;
  rdfs:range xsd:string ;
.
zxo:hasIdentificator
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;
  rdfs:range zxo:BuildingProductIdentifier ;
.
zxo:hasKeyDate
  rdf:type rdf:Property ;
  rdfs:domain zxo:LCKeyEvents ;
  rdfs:range xsd:date ;
.
zxo:hasMainUserGroup
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;

  rdfs:range xsd:string ;
.
zxo:hasBeenInstalledInBuildingOfType
  rdf:type owl:ObjectProperty ;
  rdfs:label "has building type"@en ;
  rdfs:label "hat Gebaeudetyp"@de ;
  rdfs:range zxo:BuildingType ;
.
zxo:hasBuildingProductDesciptions
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;
.
zxo:hasClassificationName
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:Classification ;
  rdfs:range xsd:string ;
.
zxo:hasConditionDescription
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:OperatingConditions ;
  rdfs:range xsd:string ;
.
zxo:hasContactData
  rdf:type owl:ObjectProperty ;
  rdfs:label "has contact data"@en ;
  rdfs:label "hat Kontaktdaten"@de ;
  rdfs:range zxo:ContactData ;
.
zxo:hasCountry
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:Address ;
  rdfs:label "has country"@en ;
  rdfs:label "hat Land"@de ;
  rdfs:range xsd:string ;
.
zxo:hasDIN276CostGroup
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:BuildingProductIdentifier ;
  rdfs:range xsd:string ;
.
zxo:hasDPP
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;
.
zxo:hasDisassemblyLocation
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:LastDisassembly ;
  rdfs:label "has disassembly location"@en ;
  rdfs:label "hat Demontageort"@de ;
  rdfs:range zxo:Address ;
.
zxo:hasEmail
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:ContactData ;
  rdfs:label "has email"@en ;
  rdfs:label "hat E-Mail"@de ;
  rdfs:range xsd:string ;
.
zxo:hasFunction
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:BuildingProductMaterialShare ;
  rdfs:label "has function"@en ;
  rdfs:label "hat Funktion"@de ;
  rdfs:range xsd:string ;
.
zxo:hasHouseNumber
  rdf:type owl:DatatypeProperty ;

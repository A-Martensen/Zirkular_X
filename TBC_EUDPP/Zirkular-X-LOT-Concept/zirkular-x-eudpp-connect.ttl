# baseURI: https://w3id.org/zirkular-x/bridge-eudpp
# imports: https://w3id.org/eudpp/
# imports: https://w3id.org/zirkular-x#

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eudpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zx: <https://w3id.org/zirkular-x#> .

zx:BuildingProduct
  rdfs:comment "Narrower: every building product is a product, not the reverse. Equivalence would infer that batteries and textiles are building products."@en ;
  rdfs:subClassOf eudpp:Product ;
.
zx:CircularityIndicator
  rdfs:comment "Narrower: the ZIRKULAR-X circularity figures are a specific set of mass fractions."@en ;
  rdfs:subClassOf eudpp:CircularEconomyIndicator ;
.
zx:DPP
  rdfs:comment "Same scope: a digital product passport as defined in ESPR Art 2 (28)."@en ;
  owl:equivalentClass eudpp:DPP ;
.
zx:Disassembly
  rdfs:comment "No EUDPP counterpart. The EVENT module has DestructionEvent, which is not the same as reversible disassembly."@en ;
  rdfs:subClassOf eudpp:ProductEvent ;
.
zx:ImpactIndicator
  rdfs:comment "The 19 EN 15804 indicators already exist as named individuals in the EUDPP LCA module (ind_GWPtotal, ind_ODP, ...). Use those rather than minting local ones."@en ;
  rdfs:subClassOf eudpp:LCIAIndicator ;
.
zx:LifecycleEvent
  rdfs:comment "Both denote an event affecting the physical product, as opposed to eudpp:DPPEvent which affects the passport record."@en ;
  owl:equivalentClass eudpp:ProductEvent ;
.
zx:Maintenance
  rdfs:comment "Direct counterpart in the EUDPP EVENT module."@en ;
  owl:equivalentClass eudpp:MaintenanceEvent ;
.
zx:Manufacturer
  rdfs:comment "Narrower: in EUDPP, manufacturer is a role an Actor holds via eudpp:ActorRoleAssignment and eudpp:manufacturer, not a class. Consider replacing zx:Manufacturer with the role pattern."@en ;
  rdfs:subClassOf eudpp:Actor ;
.
zx:MaterialComposition
  rdfs:comment "Both denote one material share of a product. Note EUDPP expresses recyclability and renewable content as booleans, whereas ZIRKULAR-X needs mass fractions; those remain local."@en ;
  owl:equivalentClass eudpp:MaterialOfComposition ;
.
zx:ProductDoc
  rdfs:comment "Both denote a document attached to a product. EUDPP treats it as a Property subclass."@en ;
  owl:equivalentClass eudpp:DocumentFormattedProperty ;
.
zx:ProductProperty
  rdfs:comment "Both denote a property of a product, either quantitative or document-formatted."@en ;
  owl:equivalentClass eudpp:Property ;
.
zx:StartOfLife
  rdfs:comment "OPEN: verify against eudpp:PlacingOnMarketEvent. PuttingIntoService is the point of first use, PlacingOnMarket the point of first availability. Decide which zx:StartOfLife means."@en ;
  owl:equivalentClass eudpp:PuttingIntoServiceEvent ;
.
zx:UniqueIdentifier
  rdfs:comment "EUDPP models identifiers as a class hierarchy with schemes and granularity (IDENT module). Prefer eudpp:identifierValue over a local literal."@en ;
  owl:equivalentClass eudpp:ProductIdentifier ;
.
<https://w3id.org/zirkular-x/bridge-eudpp>
  rdf:type owl:Ontology ;
  dcterms:created "2026-09-18"^^xsd:date ;
  dcterms:description """Alignment module. Contains only axioms relating ZIRKULAR-X terms to
EU DPP Core Ontology terms. No new classes or properties are defined here.

Follows the pattern of the EU DPP CO CONNECTOR module: cross-ontology axioms
are kept in their own file so that either side can evolve independently.

owl:equivalentClass is used where the two classes denote the same set.
rdfs:subClassOf is used where the ZIRKULAR-X class is narrower."""@en ;
  dcterms:title "ZIRKULAR-X to EU DPP Core Ontology bridge"@en ;
  vann:preferredNamespacePrefix "zxbridge" ;
  owl:imports <https://w3id.org/eudpp/> ;
  owl:imports zx: ;
  owl:versionInfo "0.1.0" ;
.

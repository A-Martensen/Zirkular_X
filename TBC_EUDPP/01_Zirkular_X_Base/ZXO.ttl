.
zxo:hasRoomID
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:Room ;
  rdfs:range xsd:string ;
.
zxo:hasSubSystemID
  rdf:type owl:DatatypeProperty ;

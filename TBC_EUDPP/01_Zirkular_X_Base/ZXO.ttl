[
  rdf:type owl:AllDifferent ;
  owl:members (
      zxo:bedienpersonal
      zxo:unterwiesenePerson
      zxo:qualifiziertesFachpersonal
    ) ;
].
[
  rdf:type owl:AllDifferent ;
  owl:members (
      zxo:wohngebaeude
      zxo:bueroUndVerwaltung
      zxo:forschungUndLehre
      zxo:gesundheitswesen
      zxo:kulturbau
      zxo:sportUndErholung
      zxo:produktionUndLagerung
      zxo:handelUndGewerbe
    ) ;
].

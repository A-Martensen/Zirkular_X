zxo:UserGroup
  rdf:type owl:Class ;
  rdfs:comment "Qualifikationsstufe des Personals fuer Bedienung, Wartung und Instandhaltung. Auswahl nach BetrSichV und DGUV."@de ;
  rdfs:label "Qualification level"@en ;
  rdfs:label "Qualifikationsstufe"@de ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          zxo:bedienpersonal
          zxo:unterwiesenePerson
          zxo:qualifiziertesFachpersonal
        ) ;
    ] ;
.
zxo:WaterUse
  rdf:type owl:Class ;
  rdfs:label "Wassernutzung"@de ;

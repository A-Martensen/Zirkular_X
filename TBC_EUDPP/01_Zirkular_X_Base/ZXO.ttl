.
zxo:BuildingSubSystem
  rdf:type owl:Class ;
  rdfs:subClassOf zxo:Building ;
.
zxo:CircularityCharacteristic
  rdf:type owl:Class ;
  rdfs:label "Circularity Characteristic"@en ;
  rdfs:label "Zirkulaere Eigenschaft"@de ;

  rdfs:label "hat Gebäudetyp"@de ;
  rdfs:range zxo:BuildingClassification ;
.
zxo:hasBuildingConstructionYear
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:Building ;
  rdfs:label "Baujahr "@de ;
  rdfs:label "Year of constructions "@en ;
  rdfs:range xsd:gYear ;
.
zxo:hasBuildingID
  rdf:type owl:DatatypeProperty ;
  rdfs:domain zxo:Building ;
  rdfs:range xsd:string ;
.
zxo:hasBuildingProductInformation
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;
  rdfs:range zxo:BuildingProductInformation ;
.
zxo:hasIntendedUserGroup
  rdf:type owl:ObjectProperty ;
  rdfs:domain zxo:BuildingProduct ;

# baseURI: https://zirkular-x.tech/ontology/ZXO
# prefix: zxo

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zxo: <https://zirkular-x.tech/ontology/ZXO#> .

<https://zirkular-x.tech/ontology/ZXO>
  rdf:type owl:Ontology ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
zxo:ADPFossil
  rdf:type owl:Class ;
  rdfs:label "Abiotic Depletion Potential, fossil resources"@en ;
  rdfs:label "Verknappung abiotischer Ressourcen - fossile Energietraeger"@de ;
  rdfs:subClassOf zxo:EnvironmentalImpactIndicator ;
  zxo:mandatoryFrom "2030" ;
.
zxo:ADPMineralsMetals
  rdf:type owl:Class ;
  rdfs:label "Abiotic Depletion Potential, minerals and metals"@en ;
  rdfs:label "Verknappung abiotischer Ressourcen - Mineralien und Metalle"@de ;
  rdfs:subClassOf zxo:EnvironmentalImpactIndicator ;
  zxo:mandatoryFrom "2030" ;
.
zxo:AcidificationPotential
  rdf:type owl:Class ;
  rdfs:label "Acidification Potential"@en ;
  rdfs:label "Versauerung"@de ;
  rdfs:subClassOf zxo:EnvironmentalImpactIndicator ;
  zxo:mandatoryFrom "2030" ;
.
zxo:Beispiel2_RLT_Anlage
  rdf:type zxo:BuildingSubSystem ;
.
zxo:Beispiel2_RM_401
  rdf:type zxo:Room ;
.
zxo:Biodegradability
  rdf:type owl:Class ;
  rdfs:label "05 Biologische Abbaubarkeit"@de ;
  rdfs:label "Biodegradability"@en ;
  rdfs:subClassOf zxo:CircularityCharacteristic ;
.
zxo:Building
  rdf:type owl:Class ;
  rdfs:label "Building Information"@en ;
  rdfs:label "Gebaeude"@de ;
  rdfs:subClassOf owl:Thing ;
.
zxo:BuildingClassification
  rdf:type owl:Class ;
  rdfs:comment "Typ des Gebäudes, Grundlage der Anforderungsableitung."@de ;
  rdfs:label "Building classification"@en ;
  rdfs:label "Gebäudetyp"@de ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          zxo:wohngebaeude
          zxo:bueroUndVerwaltung
          zxo:forschungUndLehre
          zxo:gesundheitswesen
          zxo:kulturbau
          zxo:sportUndErholung
          zxo:produktionUndLagerung
          zxo:handelUndGewerbe
        ) ;
    ] ;
.
zxo:BuildingProduct
  rdf:type owl:Class ;
.
zxo:BuildingProductInformation
  rdf:type owl:Class ;

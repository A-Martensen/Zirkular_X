  dcterms:title "CORE  of the EU DPP core ontology proposed by the CIRPASS-2 project."@en ;
  ns0:preferredNamespacePrefix "eudpp" ;
  rdfs:comment "The CORE of the EU DPP core ontology proposal of the CIRPASS-2 European project."@en ;
  rdfs:label "EU DPP CORE"@en ;

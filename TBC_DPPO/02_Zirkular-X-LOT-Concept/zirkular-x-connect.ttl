# baseURI: https://w3id.org/zirkular-x-connect
# imports: http://w3id.org/dppo/ontology/dpp-comp/
# imports: http://w3id.org/dppo/ontology/dpp-core/
# imports: http://w3id.org/dppo/ontology/dpp-info/
# imports: http://w3id.org/dppo/ontology/dpp-odp/

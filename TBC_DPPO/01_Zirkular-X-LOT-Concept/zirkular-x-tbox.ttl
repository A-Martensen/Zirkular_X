zx:
  rdf:type owl:Ontology ;
  dcterms:created "2026-09-18"^^xsd:date ;
  dcterms:creator <https://w3id.org/TODO-author-URI> ;
  dcterms:description """Classes, object properties, datatype properties and
restrictions in one file.

Assembled from:
  1. the Chowlk conversion of zirkular-x-ontology.drawio (classes, object
     properties, allValuesFrom restrictions)
  2. zirkular-x-properties.ttl, generated from gen/mapping.csv, which is
     derived from 260908_Parameterliste_DPP.xlsx

Five classes at the end were auto-declared because a property references them
but they are not yet drawn in the diagram:
  zx:Room  zx:BuildingSystem  zx:DisassemblyInst  zx:RepairInst  zx:TestReport

Alignment to the EU DPP Core Ontology is kept separate in
zirkular-x-bridge-eudpp.ttl. The 19 EN 15804 impact indicators are not
declared here; they exist as individuals in the EUDPP LCA module."""@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:title "ZIRKULAR-X Ontology, complete TBox"@en ;
  vann:preferredNamespacePrefix "zx" ;
  vann:preferredNamespaceUri zx: ;
  owl:versionIRI <https://w3id.org/zirkular-x/0.2.0> ;
  owl:versionInfo "0.2.0" ;
  mod:createdWith <https://chowlk.linkeddata.es/> ;
.
zx:Building
  rdf:type owl:Class ;
  rdfs:label "Building" ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:BuildingType ;
      owl:onProperty zx:hasBuildingType ;
    ] ;
.
zx:BuildingProduct
  rdf:type owl:Class ;
  rdfs:label "Building Product" ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:Building ;
      owl:onProperty zx:isLocatedInBuilding ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:BuildingProduct ;
      owl:onProperty zx:consistsOf ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:DPP ;
      owl:onProperty zx:hasRelatedDPP ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:LifecycleEvent ;
      owl:onProperty zx:hasLifecycleEvent ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:Manufacturer ;
      owl:onProperty zx:hasManufacturer ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:MaterialComposition ;
      owl:onProperty zx:hasMaterialComposition ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:ProductDoc ;
      owl:onProperty zx:hasProductDocumentation ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:ProductProperty ;
      owl:onProperty zx:hasProductProperty ;
    ] ;
.
zx:BuildingSystem
  rdf:type owl:Class ;
  rdfs:comment "Auto-declared: referenced by a property but not yet drawn in the diagram."@en ;
  rdfs:label "BuildingSystem"@en ;
.
zx:BuildingType
  rdf:type owl:Class ;
  rdfs:comment "Geschlossene Liste von acht Gebaeudetypen. Ein Gebaeude kann mehreren Typen zugeordnet sein."@de ;
  rdfs:label "Gebaeudetyp"@de ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          zx:btResidential
          zx:btOffice
          zx:btEducationResearch
          zx:btHealthcare
          zx:btCultural
          zx:btSportsRecreation
          zx:btProductionStorage
          zx:btRetailCommercial
        ) ;
    ] ;
.
zx:CircularityIndicator
  rdf:type owl:Class ;
  rdfs:label "Circularity Indicator" ;
  rdfs:subClassOf zx:ProductProperty ;
.
zx:CompDesc
  rdf:type owl:Class ;
  rdfs:label "Comp Desc" ;
  rdfs:subClassOf zx:ProductDoc ;
.
zx:DPP
  rdf:type owl:Class ;
  rdfs:label "D P P" ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:BuildingProduct ;
      owl:onProperty zx:hasRelatedProduct ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:UniqueIdentifier ;
      owl:onProperty zx:hasIdentifier ;
    ] ;
.
zx:Disassembly
  rdf:type owl:Class ;
  rdfs:label "Disassembly" ;
  rdfs:subClassOf zx:LifecycleEvent ;
.
zx:DisassemblyInst
  rdf:type owl:Class ;
  rdfs:comment "Auto-declared: referenced by a property but not yet drawn in the diagram."@en ;
  rdfs:label "DisassemblyInst"@en ;
.
zx:EOLRecs
  rdf:type owl:Class ;
  rdfs:label "E O L Recs" ;
  rdfs:subClassOf zx:ProductDoc ;
.
zx:HVACProduct
  rdf:type owl:Class ;
  rdfs:label "H V A C Product" ;
  rdfs:subClassOf zx:BuildingProduct ;
.
zx:ImpactIndicator
  rdf:type owl:Class ;
  rdfs:label "Impact Indicator" ;
  rdfs:subClassOf zx:ProductProperty ;
.
zx:InstallationInst
  rdf:type owl:Class ;
  rdfs:label "Installation Inst" ;
  rdfs:subClassOf zx:ProductDoc ;
.
zx:LifecycleEvent
  rdf:type owl:Class ;
  rdfs:label "Lifecycle Event" ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:dateTime ;
      owl:onProperty zx:hasTimeDate ;
    ] ;
.
zx:Maintenance
  rdf:type owl:Class ;
  rdfs:label "Maintenance" ;
  rdfs:subClassOf zx:LifecycleEvent ;
.
zx:Manufacturer
  rdf:type owl:Class ;
  rdfs:label "Manufacturer" ;
.
zx:Material
  rdf:type owl:Class ;
  rdfs:label "Material" ;
.
zx:MaterialComposition
  rdf:type owl:Class ;
  rdfs:label "Material Composition" ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:Material ;
      owl:onProperty zx:consistsOfMaterial ;
    ] ;
.
zx:ProductDoc
  rdf:type owl:Class ;
  rdfs:label "Product Doc" ;
.
zx:ProductProperty
  rdf:type owl:Class ;
  rdfs:label "Product Property" ;
.
zx:RepairInst
  rdf:type owl:Class ;
  rdfs:comment "Auto-declared: referenced by a property but not yet drawn in the diagram."@en ;
  rdfs:label "RepairInst"@en ;
.
zx:Room
  rdf:type owl:Class ;
  rdfs:comment "Auto-declared: referenced by a property but not yet drawn in the diagram."@en ;
  rdfs:label "Room"@en ;
.
zx:SafetyInst
  rdf:type owl:Class ;
  rdfs:label "Safety Inst" ;
  rdfs:subClassOf zx:ProductDoc ;
.
zx:StartOfLife
  rdf:type owl:Class ;
  rdfs:label "Start Of Life" ;
  rdfs:subClassOf zx:LifecycleEvent ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty zx:hasProductionLocation ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom zx:Manufacturer ;
      owl:onProperty zx:performedBy ;
    ] ;
.
zx:TestReport

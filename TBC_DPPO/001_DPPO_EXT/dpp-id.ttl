# baseURI: https://w3id.org/dpp-id
# prefix: dpp-id

@prefix dpp-id: <https://w3id.org/dpp-id#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dpp-id>
  rdf:type owl:Ontology ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
dpp-id:Batch
  rdf:type owl:NamedIndividual ;
  rdf:type dpp-id:IDGranularity ;
  rdfs:label "batch" ;
.
dpp-id:ID
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty dpp-id:hasUniqueID ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onClass dpp-id:IDGranularity ;
      owl:onProperty dpp-id:hasGranularity ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
.
dpp-id:IDGranularity
  rdf:type owl:Class ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf (
          dpp-id:Model
          dpp-id:Batch
          dpp-id:Item
        ) ;
    ] ;
.
dpp-id:Item
  rdf:type owl:NamedIndividual ;
  rdf:type dpp-id:IDGranularity ;
  rdfs:label "item" ;
.
dpp-id:Model
  rdf:type owl:NamedIndividual ;
  rdf:type dpp-id:IDGranularity ;
  rdfs:label "model" ;
.
dpp-id:hasGranularity
  rdf:type owl:FunctionalProperty ;
  rdf:type owl:ObjectProperty ;
  rdfs:domain dpp-id:ID ;
  rdfs:range dpp-id:IDGranularity ;
.
dpp-id:hasUniqueIndentifier
  rdf:type owl:DatatypeProperty ;
  rdfs:domain dpp-id:ID ;
  rdfs:range xsd:string ;
.
[
  rdf:type owl:AllDifferent ;
  owl:distinctMembers (
      dpp-id:Model
      dpp-id:Batch
      dpp-id:Item
    ) ;
].
